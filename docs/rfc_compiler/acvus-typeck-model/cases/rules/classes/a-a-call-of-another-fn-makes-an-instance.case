//@ spec: l.197, l.202, l.222, with l.217, l.219, l.226, l.301, l.344
// fn f(x) { take_u8(x) }   // a module's fn; take_u8(u8)
// f(1u16)                  // the script
// In f, take_u8 reads X, a universal with no relation left, which decides
// nothing (l.344): it is take_u8, and x ⇝ u8 rests on X, in f's C (l.219).
// The script's call is of another binding group's fn, so it makes one
// instance (l.202): its X' is an unknown the argument meets (l.222), u16, and
// the copied u16 ⇝ u8 has no coercion (l.301).
extern fn take_u8(u8);

group f {
    let X;
    let `f result`;
    fn f(X) -> `f result`;
    let `take_u8(x)`;
    `take_u8(x)` = take_u8(X) @ take_u8;
    `f result` = `take_u8(x)`;
}
let 1u16: u16;
let `f(1u16)`;
`f(1u16)` = f(1u16) @ `f(1u16)`;

must fail;
assert failing [`f@2/X ~> f@2/take_u8.Param(0)`];
