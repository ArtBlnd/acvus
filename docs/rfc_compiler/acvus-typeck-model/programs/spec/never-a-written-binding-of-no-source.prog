// from cases/spec/never-a-written-binding-of-no-source.case
// let t; t.0 = 1u8; takes_u8(t);
// T takes no constructor from the structure constraint t.0 gives and falls back to !.
// ! satisfies every structure constraint, the part it names being !, so 1u8 enters t.0 of
// type ! and does not reach it: refused there, so that t, which holds
// what was written into it, never passes as u8.
// not asserted here: assert failing [`1u8 <= t.0`];
one_u8 <- u8;
t_0: t_0 <- t.0;
t_0 <- one_u8;
declare takes_u8_p0 = u8;
declare takes_u8_result = ();
takes_u8_0: pass t to takes_u8_p0;
takes_u8_t <- takes_u8_result;

assert refused ..;
