// A producer and a consumer share one `deque`: every round pushes a task
// on the back, and every second round pops one off the front, so the order
// out is the order in.
// The deque is built here from the context array its init gives, so the
// run leaves `@tasks` as it found it; a deque held in a space as a context
// would be committed back after every run.

let pending = deque();
let served = vec([]);
let high_water = 0u64;
let round = 0;

for task in &@tasks {
    pending.push_back(task.name.to_string());
    let depth = pending.len();
    if depth > high_water {
        high_water = depth;
    };
    round = round + 1;
    if round % 2 == 0 {
        if let Some(name) = pending.pop_front() {
            served.push(name);
        };
    };
}

while let Some(name) = pending.pop_front() {
    served.push(name);
}

let count = served.len();
let out = "{{ &round | to_string }} rounds, deepest {{ &high_water | to_string }}, {{ &count | to_string }} served";
for served_name in &served {
    let name = served_name.to_string();
    out = out + "
{{ &name }}";
}
out
