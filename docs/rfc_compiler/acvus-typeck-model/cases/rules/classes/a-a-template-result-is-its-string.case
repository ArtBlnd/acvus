// A template whose control line returns 1u8:
// % return 1u8;
// A template's result type is fixed to String, no unknown, so
// the returned value passes into it at the coercion constraint 1u8 ⇝ R, and u8 reaches
// String by no coercion. Its text, the String it formats, is
// its tail.
let R: String;
fn run() -> R;
let 1u8: u8;
let text: String;
R = 1u8;
R = text;

must fail;
assert failing [`1u8 ~> R`];
