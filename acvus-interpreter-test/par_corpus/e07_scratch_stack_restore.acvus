// id: E07
// family: effects
// desc: pop -> work -> push on a shared scratch vec, restored each iteration; `pop` states `inverse = push` and `unwrap` states `payload`
// expect: 15,13,18|1
let scratch = vec([10]);
let xs = vec([5, 3, 8]);
let out = vec([]);
for x in &xs {
    let base = scratch.pop().unwrap();
    out.push(base + *x);
    scratch.push(base);
}
out.into_iter().map(|x| -> x.to_string()).join(",".to_string()) + "|" + scratch.len().to_string()
