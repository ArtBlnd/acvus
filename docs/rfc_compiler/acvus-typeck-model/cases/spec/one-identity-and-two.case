// let a = open();                     // open() -> F⟨new⟩, a cast F → G, G with no identity
// at(&a, index_of(&a));               // index_of(&F⟨p⟩) -> Idx⟨p⟩, at(&F⟨p⟩, Idx⟨p⟩)
// let b = if c { open() } else { a };
// Each open() makes an identity anew. index_of's and at's p are unified with
// a's identity by the decomposition's equations, so the second line holds with one
// identity. b's lower bounds carry two different identities, which no class
// holds, so its value is G, the nearest ancestor that carries none, and each
// value is cast up to it.
extern type F<#>;
extern type G;
extern type Idx<#>;
extern fn open<#>() -> F<#>;
extern fn index_of<#>(&F<#>) -> Idx<#>;
extern fn at<#>(&F<#>, Idx<#>);
#[cast] extern fn forget<#>(F<#>) -> G;
let A;
let `open() 1`;
let `&a 1`;
let `&a 2`;
let `index_of(..)`;
let `at(..)`;
let B;
let `open() 2`;
`open() 1` = open() @ `open 1`;
A = `open() 1`;
`&a 1` = &A @ `lend 1`;
`&a 2` = &A @ `lend 2`;
`index_of(..)` = index_of(`&a 2`) @ index_of;
`at(..)` = at(`&a 1`, `index_of(..)`) @ at;
`open() 2` = open() @ `open 2`;
B = `open() 2`;
B = A;

must pass;
assert B: G;
