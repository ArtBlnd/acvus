//@ hole: T6
//@ spec: l.276
// let n = never();         // never() -> !
// if let Some(x) = n { }
// The kind "has variant Some" gives no member, so N is !; since 87efde71 `!`,
// which has no value, meets every kind (l.276), so the pattern decides
// nothing, as patterns §4 has it, and x's type, which nothing enters, falls
// back to ! (l.288).
extern fn never() -> !;

let N;
let `never()`;
let `Some.0`;
let X;
`never()` = never() @ never;
N = `never()`;
`Some.0` = N as Some @ Some;
X = bind `Some.0` via [Some] @ x;

must pass;
assert N: !;
assert X: !;
