=== main ===
     0 |   r0 = fetch @stats
     1 |   assign @stats = r0
     2 |   r1 = take @stats.count
     4 |   r2 = r1 + 1 (r3)
     5 |   assign count = r2
     6 |   r4 = take count
     7 |   r5 = take @stats.threshold
     8 |   r6 = r4 > r5
     9 |   r7 = test r6 == true
    10 |   if r7 -> L0 else L1 join L1
    11 | L0:
    12 |   r8 = take count
    13 |   assign @stats.count = r8
    15 |   assign @stats.exceeded = true (r9)
    16 |   jump L1
    17 | L1:
    19 |   r10 = take @stats.count
    20 |   r11 = take @stats
    21 |   commit @stats = r11
    22 |   return r10

