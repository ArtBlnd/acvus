// let r = &1u8;
// r.f;
// r is a reference, so the field projection applies to its target, the
// class of 1u8, whose kind u8 has no field f: the conjunction no type meets
// leaves it with no value, refused there. One outcome in every
// order: the target, a part of R, waits for R to take its constructor,
// which the model once let it solve before, in two outcomes.
let 1u8: u8;
let `&1u8`;
let R;
let `r.f`;
`&1u8` = &1u8 @ `&1u8`;
R = `&1u8`;
`r.f` = R.f @ `r.f`;

must fail;
assert `r.f` == applied through &;
assert refused conflict at "1u8 = R.Target";
