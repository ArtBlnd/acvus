//@ spec: l.339, l.89, l.91, l.221, l.280, l.284
//@ orders: sampled 200
// fn f() { let a = get1()?; let b = get2()?; Ok(a) }
// // get1() -> Result<u8, E1>, get2() -> Result<u16, E2>
// Each ? reads its operand's outer constructor, Result, and is decided as
// ?(Result<T, E>) (l.339). Its exit's value is Result<O, X>, which passes
// into f's result, an unknown: a meeting (l.221). E takes E1, a type of a
// name, so the wrapping splits X into Error{E1(..)} (l.280, l.339); the
// other into Error{E2(..)}. f's result's error part joins the two by ⊔ₚ,
// uniting the variants (l.89), and the exits' ok parts, which nothing
// enters, are filled with u8 (l.284).
extern type E1;
extern type E2;
extern fn get1() -> Result<u8, E1>;
extern fn get2() -> Result<u16, E2>;
group f {
    let `f result`;
    fn f() -> `f result`;
    let `get1()`;
    let A;
    let `exit 1`;
    let `get2()`;
    let B;
    let `exit 2`;
    let S;
    let P;
    let `Ok(a)`: Result<S, P>;
    `get1()` = get1() @ get1;
    A = ?(`get1()`) into `exit 1` @ q1;
    `f result` = `exit 1`;
    `get2()` = get2() @ get2;
    B = ?(`get2()`) into `exit 2` @ q2;
    `f result` = `exit 2`;
    S = A;
    `f result` = `Ok(a)`;
}
let `f()`;
`f()` = f() @ `f()`;

must pass;
assert q1 == ?#1;
assert q2 == ?#1;
assert `f result`: Result<u8, Error{E1(E1), E2(E2)}>;
assert `f()`: Result<u8, Error{E1(E1), E2(E2)}>;
