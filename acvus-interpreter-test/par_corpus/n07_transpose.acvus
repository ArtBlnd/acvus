// id: N07
// family: nested
// desc: transpose `t[j][i] = m[i][j]`, a 2-D affine store permuting the axes
// expect: 1,4|2,5|3,6
let m = vec([vec([1, 2, 3]), vec([4, 5, 6])]);
let t = vec([vec([0, 0]), vec([0, 0]), vec([0, 0])]);
for i in 0u64..2u64 {
    for j in 0u64..3u64 {
        t[j][i] = m[i][j];
    }
}
t[0u64].as_iter().map(|x| -> (*x).to_string()).join(",".to_string()) + "|" + t[1u64].as_iter().map(|x| -> (*x).to_string()).join(",".to_string()) + "|" + t[2u64].as_iter().map(|x| -> (*x).to_string()).join(",".to_string())
