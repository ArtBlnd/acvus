-- compute_score --
=== main ===
     0 |   r0 = take $v1
     1 |   r1 = take $v2
     2 |   r2 = r0 + r1
     3 |   r3 = take $v3
     4 |   r4 = r2 * r3
     6 |   r5 = r4 / 100 (r6)
     7 |   return r5

