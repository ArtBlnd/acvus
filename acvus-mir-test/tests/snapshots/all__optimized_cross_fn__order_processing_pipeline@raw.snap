-- main --
=== main ===
     0 |   assign $order = r0
     1 |   r1 = fetch @item_count
     2 |   assign @item_count = r1
     3 |   r2 = fetch @total_out
     4 |   assign @total_out = r2
     5 |   r3 = fetch @shipping
     6 |   assign @shipping = r3
     7 |   r4 = fetch @tax_rate
     8 |   assign @tax_rate = r4
     9 |   r5 = fetch @default_ship
    10 |   assign @default_ship = r5
    11 |   r6 = fetch @receipt_out
    12 |   assign @receipt_out = r6
    13 |   r7 = fetch @discount_rate
    14 |   assign @discount_rate = r7
    15 |   r8 = fetch @customer
    16 |   assign @customer = r8
    17 |   r9 = fetch @free_ship_min
    18 |   assign @free_ship_min = r9
    19 |   r10 = take @item_count
    21 |   r11 = r10 * 100 (r12)
    22 |   assign subtotal = r11
    23 |   r13 = take subtotal
    24 |   r14 = take @discount_rate
    25 |   r15 = call #0(r13, r14)
    26 |   assign discount = r15
    27 |   r16 = take subtotal
    28 |   r17 = take discount
    29 |   r18 = r16 - r17
    30 |   r19 = take @tax_rate
    31 |   r20 = call #1(r18, r19)
    32 |   assign tax = r20
    33 |   r21 = take subtotal
    34 |   r22 = take discount
    35 |   r23 = r21 - r22
    36 |   r24 = take tax
    37 |   r25 = r23 + r24
    38 |   assign total = r25
    39 |   r26 = take total
    40 |   r27 = take @free_ship_min
    41 |   r28 = r26 > r27
    42 |   r29 = test r28 == true
    43 |   if r29 -> L0 else L1 join L1
    44 | L0:
    46 |   assign @shipping = 0 (r30)
    47 |   jump L1
    48 | L1:
    50 |   r31 = take total
    51 |   r32 = take @free_ship_min
    52 |   r33 = r31 <= r32
    53 |   r34 = test r33 == true
    54 |   if r34 -> L2 else L3 join L3
    55 | L2:
    56 |   r35 = take @default_ship
    57 |   assign @shipping = r35
    58 |   jump L3
    59 | L3:
    61 |   r36 = take total
    62 |   r37 = take @shipping
    63 |   r38 = r36 + r37
    64 |   assign final_total = r38
    65 |   r39 = take @customer
    66 |   r40 = take subtotal
    67 |   r41 = take discount
    68 |   r42 = take tax
    69 |   r43 = take @shipping
    70 |   r44 = take final_total
    71 |   r45 = call #2(r39, r40, r41, r42, r43, r44)
    72 |   assign receipt = r45
    73 |   r46 = take final_total
    74 |   assign @total_out = r46
    75 |   r47 = take receipt
    76 |   assign @receipt_out = r47
    77 |   r48 = take receipt
    78 |   r49 = take $order
    79 |   r50 = call #3(r48) [r49 -> r51]
    80 |   assign $order = r51
    81 |   r52 = take final_total
    82 |   r53 = take @item_count
    83 |   commit @item_count = r53
    84 |   r54 = take @total_out
    85 |   commit @total_out = r54
    86 |   r55 = take @shipping
    87 |   commit @shipping = r55
    88 |   r56 = take @tax_rate
    89 |   commit @tax_rate = r56
    90 |   r57 = take @default_ship
    91 |   commit @default_ship = r57
    92 |   r58 = take @receipt_out
    93 |   commit @receipt_out = r58
    94 |   r59 = take @discount_rate
    95 |   commit @discount_rate = r59
    96 |   r60 = take @customer
    97 |   commit @customer = r60
    98 |   r61 = take @free_ship_min
    99 |   commit @free_ship_min = r61
   100 |   r62 = take $order
   101 |   return r52 [r62]

