// expect 1
// `remove` takes an entry out, which moves its key's place among the table's keys where it comes back.
let xs = vec([1, 2, 1, 3]);
let m = hash_map();
insert(&mut m, 1, 10);
insert(&mut m, 2, 20);
insert(&mut m, 3, 30);
for x in &xs {
    remove(&mut m, x);
}
insert(&mut m, 4, 40);
len(&m)
