//@ spec: l.335
// f(0)                     // f(u8), f(u16)
// The LitVar decides nothing within its family, so both remain only because of
// it; taken as its default i32, it reaches neither (l.335).
extern fn f(u8);
extern fn f(u16);

let 0: lit 0;
let R;
R = f(0) @ f;

must fail;
assert f == undecided;
