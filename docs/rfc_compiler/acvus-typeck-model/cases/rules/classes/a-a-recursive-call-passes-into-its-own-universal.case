//@ spec: l.201, l.217, with l.202, l.218, l.222, l.226, l.301
// fn g(a) { g(1u8) }       // a module's fn
// g("s")                   // the script
// g's call of itself is a call within its binding group, so it makes no
// instance and takes g's own types (l.201): 1u8 passes into g's A, a universal
// and no unknown (l.217, l.218), the boundary 1u8 ⇝ A, resting on A, in g's C.
// g("s") makes an instance (l.202) whose A' is an unknown the argument meets
// (l.222), &str, and the copied u8 ⇝ &str has no coercion (l.301).
group g {
    let A;
    let `g result`;
    fn g(A) -> `g result`;
    let 1u8: u8;
    let `g(1u8)`;
    `g(1u8)` = g(1u8) @ `g(1u8)`;
    `g result` = `g(1u8)`;
}
let str: str;
let `"s"`: &str;
let `g("s")`;
`g("s")` = g(`"s"`) @ `g("s")`;

must fail;
assert failing [`g@2/1u8 ~> g@2/A`];
