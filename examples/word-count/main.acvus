// Word counts over the context text: `split_whitespace` cuts it, `lower`
// folds the case, and a trailing period or comma is stripped with
// `strip_suffix`.
// The top three words come out by count descending and, where counts tie,
// by the word's bytes ascending -- `string::lt` is that order, Rust's
// `Ord for str`, because the `<` operator does not reach text.

let bare = |w| -> w.strip_suffix(".").or_else(| | -> w.strip_suffix(",")).unwrap_or(w);

let words = vec([]);
let tally = vec([]);
let total = 0;

let raw = &@text | split_whitespace;
while let Some(token) = raw.next() {
    let word = bare(token.lower());
    total = total + 1;
    let seen = false;
    for i in 0u64..words.len() {
        if words[i] == word {
            tally[i] = tally[i] + 1;
            seen = true;
            break;
        };
    }
    if !seen {
        words.push(word);
        tally.push(1);
    };
}

let order = vec([]);
for i in 0u64..words.len() {
    order.push(i);
}
let counts = &tally;
let names = &words;
order.sort_by(|a, b| -> {
    let x = *a;
    let y = *b;
    if counts[x] > counts[y] {
        0 - 1
    } else if counts[y] > counts[x] {
        1
    } else if lt(&names[x], &names[y]) {
        0 - 1
    } else {
        1
    }
});

let distinct = words.len();
let wanted = 3u64;
let shown = min(distinct, wanted);

let out = "{{ &total | to_string }} words, {{ &distinct | to_string }} distinct, top {{ &shown | to_string }}:";
for k in 0u64..shown {
    let at = order[k];
    let word = words[at].to_string();
    let count = tally[at];
    out = out + "
{{ &word }} {{ &count | to_string }}";
}
out
