//@ spec: l.186, l.278
// let x = 0;
// let f = || takes_u8(x);  // takes_u8(u8)
// f();
// takes_u8's constraint at its argument is the enclosing group's (l.186), and
// X, holding the literal's LitVar, is unified with u8 by its boundary
// (l.278).
extern fn takes_u8(u8);

group λ in run {
    let `λ result`;
    let `takes_u8(x)`;
    fn λ() -> `λ result`;
    `λ result` = `takes_u8(x)`;
}
let 0: lit 0;
let X;
let `|| ..`: lambda λ;
let f;
X = 0;
f = `|| ..`;
let `f()`;
`f()` = (f)() @ `f()`;
group λ {
    `takes_u8(x)` = takes_u8(X) @ takes_u8;
}

must pass;
assert X: u8;
