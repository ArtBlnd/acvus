// id: S06
// family: search
// desc: 2-D search, returning (row, col) of the first match from a nested loop
// expect: [1,2]
let find = |m| -> {
    for i in 0u64..m.len() {
        for j in 0u64..m[i].len() {
            if m[i][j] == 7 {
                return (i, j);
            };
        }
    }
    (99u64, 99u64)
};
find(vec([vec([1, 2, 3]), vec([4, 5, 7]), vec([7, 0, 0])]))
