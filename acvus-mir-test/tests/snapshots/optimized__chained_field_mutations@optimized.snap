=== main ===
     0 |   r0 = ref @state
     1 |   r1 = load r0
     2 |   r2 = r1.step
     3 |   r3 = const 1
     4 |   r4 = r2 + r3
     5 |   r5 = field_set r1.step = r4
     6 |   r2 = r5.value
     7 |   r3 = r5.multiplier
     8 |   r4 = r2 * r3
     9 |   r1 = field_set r5.value = r4
    10 |   r2 = r1.step
    11 |   r3 = r1.max_steps
    12 |   r6 = r2 >= r3
    13 |   r5 = field_set r1.done = r6
    14 |   r0 = ref @state
    15 |   store r0 = r5
    16 |   return r5

    ; r0 (@state) : Ref<{done: Bool, max_steps: Int, multiplier: Int, step: Int, value: Int}>
    ; r1 (@state) : {done: Bool, max_steps: Int, multiplier: Int, step: Int, value: Int}
    ; r2 (step) : Int
