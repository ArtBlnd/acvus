//@ spec: l.221, l.229, l.276, l.292
// let mut last = None;
// let remember = |x| last = Some(x);
// remember(1u8);
// remember(2u16);
// last is reached by name and its type L is an unknown of the enclosing binding
// group, so the write in the lambda is a meeting, L ≥ Some(x) (l.221, l.229).
// x's type is universal (l.212), so the lower bound stays in the lambda's C and
// each call copies it with its own X' (l.217). L takes Option, and its payload
// has the lower bounds ?k, S' = u8 and S'' = u16, which have no join (l.276):
// refused at L's payload (l.292).
group λ in run {
    let X;
    let S;
    let `Some(x)`: Option<S>;
    let `()`: ();
    let `λ result`;
    fn λ(X) -> `λ result`;
    S = X;
}
let L;
let ?k;
let None: Option<?k>;
let `|x| ..`: lambda λ;
let remember;
L = None;
remember = `|x| ..`;
let 1u8: u8;
let `remember(1u8)`;
`remember(1u8)` = (remember)(1u8) @ `remember(1u8)`;
let 2u16: u16;
let `remember(2u16)`;
`remember(2u16)` = (remember)(2u16) @ `remember(2u16)`;
group λ {
    #[by_name] L = `Some(x)`;
    `λ result` = `()`;
}

must fail;
assert `remember(1u8)` == calls {λ};
assert `remember(2u16)` == calls {λ};
assert refused no_join `L.Payload(Some)`;
