// refuse
// keep_in_state's `T` is opaque: a `#[state]` holding a value of it past the call would hold a loan.
let v = vec(["hello".to_string()]); let k = match get(&v, 0u64) { Some(p) => keep_in_state(p), None => None }; v = vec(["zz".to_string()]); let w = "x".to_string(); match keep_in_state(&w) { Some(p) => len(p), None => 0u64 }
