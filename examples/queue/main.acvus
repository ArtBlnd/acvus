// A producer and a consumer share one `deque`: every round pushes a task
// on the back, and every second round pops one off the front, so the order
// out is the order in.
// The deque is built from a context array because a context value's type
// comes from JSON, which has no deque; a deque held in a space is what
// `--commit` writes back.

let pending = deque();
let served = vec([]);
let high_water = 0u64;
let round = 0;

let tasks = @tasks.as_iter();
while let Some(task) = tasks.next() {
    pending.push_back(task.name.to_string());
    let depth = pending.len();
    if depth > high_water {
        high_water = depth;
    };
    round = round + 1;
    if round % 2 == 0 {
        if let Some(name) = pending.pop_front() {
            served.push(name);
        };
    };
}

while let Some(name) = pending.pop_front() {
    served.push(name);
}

let count = served.len();
let out = "{{ &round | to_string }} rounds, deepest {{ &high_water | to_string }}, {{ &count | to_string }} served";
let i = 0u64;
while i < served.len() {
    let name = served[i].to_string();
    out = out + "
{{ &name }}";
    i = i + 1u64;
}
out
