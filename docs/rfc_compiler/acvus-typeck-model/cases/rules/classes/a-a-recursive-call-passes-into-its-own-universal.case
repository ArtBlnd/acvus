// fn g(a) { g(1u8) }       // a module's fn
// g("s")                   // the script
// g's call of itself is a call within its binding group, so it makes no
// instance and takes g's own types: 1u8 passes into g's A, a universal
// and no unknown, the coercion constraint 1u8 ⇝ A, resting on A, in g's C.
// g("s") makes an instance whose A' is an unknown the argument meets,
// &str, and the copied u8 ⇝ &str has no coercion.
group g {
    let A;
    let `g result`;
    fn g(A) -> `g result`;
    let 1u8: u8;
    let `g(1u8)`;
    `g(1u8)` = g(1u8) @ `g(1u8)`;
    `g result` = `g(1u8)`;
}
let str: str;
let `"s"`: &str;
let `g("s")`;
`g("s")` = g(`"s"`) @ `g("s")`;

must fail;
assert failing [`g@2/1u8 ~> g@2/A`];
