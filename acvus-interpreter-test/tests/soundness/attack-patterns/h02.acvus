// expect "the quick brown fox jumps over it1"
// same through a Some payload
let o = Some(("the quick brown fox jumps over it".to_string(), vec([1]))); match o { Some(("nope nope nope nope nope nope nope", w)) => "a".to_string(), Some(whole) => match whole { (s, v) => s + &v.len().to_string(), _ => "".to_string(), }, _ => "n".to_string(), }
