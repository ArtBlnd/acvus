// id: M02
// family: map-filter
// desc: map over `xs.into_iter()` drained by `while let Some(x) = it.next()`, a traversal with no `for`
// expect: 10,6,16
let xs = vec([5, 3, 8]);
let it = xs.into_iter();
let out = vec([]);
while let Some(x) = it.next() {
    out.push(x * 2);
}
out.into_iter().map(|x| -> x.to_string()).join(",".to_string())
