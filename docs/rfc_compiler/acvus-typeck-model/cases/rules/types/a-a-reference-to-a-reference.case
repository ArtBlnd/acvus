// let x = 1u8;
// g(&x);                   // g<T>(T) -> &T
// &x is &u8 and passes into the unknown T, a meeting, so T is &u8. The result
// &T would then be a reference whose target is a reference, and no type is
// that: the use's result has no value.
extern fn g<T>(T) -> &T;

let 1u8: u8;
let X;
let `&x`;
let `g(&x)`;
X = 1u8;
`&x` = &X @ lend;
`g(&x)` = g(`&x`) @ g;

must fail;
assert `g(&x)`: none;
assert refused no_value `g(&x)`;
