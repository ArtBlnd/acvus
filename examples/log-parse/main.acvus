// Each log line is `timestamp level message`, cut by one regular
// expression whose three named groups are the fields; the levels are
// tallied against a fixed list, so the report's order is the list's.
// The first and the last timestamp are parsed as dates, so the span
// between them is a count of seconds; the longest message is measured in
// bytes, which is what `len` on a string counts.

let line_re = regex("^(?<stamp>\\S+) (?<level>\\S+) (?<message>.*)$".to_string())?;
let stamp_format = "%Y-%m-%dT%H:%M:%S".to_string();

let levels = vec(["ERROR".to_string(), "WARN".to_string(), "INFO".to_string()]);
let counts = vec([0, 0, 0]);

let first = "".to_string();
let last = "".to_string();
let seen = 0;
let longest = 0u64;

let records = &@log | lines;
while let Some(line) = next(&mut records) {
    let fields = unwrap(captures(&line_re, &line));
    let stamp = unwrap(named(&fields, "stamp".to_string())).text;
    let level = unwrap(named(&fields, "level".to_string())).text;
    let message = unwrap(named(&fields, "message".to_string())).text;

    let i = 0u64;
    while i < len(&levels) {
        if levels[i] == level {
            counts[i] = counts[i] + 1;
        };
        i = i + 1u64;
    }

    if seen == 0 {
        first = stamp.to_string();
    };
    last = stamp;
    seen = seen + 1;

    let width = len(&message);
    if width > longest {
        longest = width;
    };
}

let opened = parse_date(first.to_string(), stamp_format.to_string())?;
let closed = parse_date(last.to_string(), stamp_format.to_string())?;
let span = timestamp(closed) - timestamp(opened);

let out = "{{ &seen | to_string }} lines over {{ &span | to_string }} seconds, {{ &first }} .. {{ &last }}";
let i = 0u64;
while i < len(&levels) {
    let level = levels[i].to_string();
    let count = counts[i];
    out = out + "
{{ &level }} {{ &count | to_string }}";
    i = i + 1u64;
}
out + "
longest message {{ &longest | to_string }} bytes"
