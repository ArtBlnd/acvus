//@ hole: O4
// let mut x = make_a();    // make_a() -> A, make_b() -> B; a cast A → B, a conversion B → A
// let put = |v| x = v;
// put(make_b());
// V ≤ X is the lambda's environment, the enclosing group's (l.188), and V lies
// at the call's positions (l.240), so X waits for it.
extern type A;
extern type B;
extern fn make_a() -> A;
extern fn make_b() -> B;
#[cast] extern fn up(A) -> B;
#[conversion] extern fn down(B) -> A;
extern fn probe(A);
extern fn probe(B);

group λ in run {
    let V;
    let `()`: ();
    let `λ result`;
    fn λ(V) -> `λ result`;
    `λ result` = `()`;
}
let X;
let `make_a()`;
let `|v| ..`: lambda λ;
let put;
let `make_b()`;
let `put(..)`;
`make_a()` = make_a() @ make_a;
X = `make_a()`;
put = `|v| ..`;
`make_b()` = make_b() @ make_b;
`put(..)` = (put)(`make_b()`) @ `put(..)`;
group λ {
    #[by_name] X = V;
}

must pass;
assert X: B;
