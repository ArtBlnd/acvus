// id: O05
// family: other
// desc: per row, a sorted copy and its median written at the row's index
// expect: 3,5
let m = vec([vec([5, 1, 3]), vec([9, 5, 2])]);
let med = vec([0, 0]);
for i in 0u64..m.len() {
    let r = m[i].as_iter().map(|x| -> *x).collect();
    r.sort_by(|a, b| -> a - b);
    med[i] = r[1u64];
}
med.into_iter().map(|x| -> x.to_string()).join(",".to_string())
