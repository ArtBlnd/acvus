// from cases/rules/solving/a-a-class-nothing-enters-takes-its-one-context.case
// let x; take_u16(x);
// Nothing enters X, so X is contextually typed: it is unified with the one
// type of the context it passes into, u16, and reaches it by identity. No
// coercion is taken at a context: the type a context gives is the type
// written there.
// not asserted here: assert check `X ~> take.Param(0)` == identity;
declare take_p0 = u16;
declare take_result = ();
take_0: pass x to take_p0;
take_u16_x <- take_result;

assert accepted;
assert x: u16;
