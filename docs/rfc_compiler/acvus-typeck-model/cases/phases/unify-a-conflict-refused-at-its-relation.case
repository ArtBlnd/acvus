// The projection, decided, records that @cfg has the field extra, which the
// object {name} the host gives does not hold: refused at that relation.
//@ order: decide `@cfg.extra`
let String: String;
let `@cfg`: host {name: String};
let `@cfg.extra`;
let 1: lit 1;
`@cfg.extra` = `@cfg`.extra @ `@cfg.extra`;
`@cfg.extra` = 1;

assert trace "decide `@cfg.extra`: applied";
assert disjunction records `@cfg: field extra: @cfg.extra`;
must fail;
assert refused conflict at "@cfg: field extra: @cfg.extra";
