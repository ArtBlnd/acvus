//@ spec: l.276, l.282
// let o; if let Some(x) = o { takes_u8(x) }
// O takes Option from the kind alone (l.276), and x, which nothing enters, is
// filled with the u8 it passes into (l.282): o is read back as Option<u8>.
extern fn takes_u8(u8);
let O;
let `Some.0`;
let X;
let `takes_u8(x)`;
`Some.0` = O as Some @ Some;
X = bind `Some.0` via [Some] @ x;
`takes_u8(x)` = takes_u8(X) @ takes_u8;

must pass;
assert O: Option<u8>;
assert X: u8;
