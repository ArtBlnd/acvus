//@ spec: l.320, l.333
// let b = !(p && q); let k = x ^ 1; let s = n << 2;   // x: u16, n: u8
// &&, !, ^ and << have the language's candidates (l.320), written here as
// declarations, ^ and << at three integers. x decides ^ at u16; n decides <<'s
// first position at u8, and its second, a literal, at the default i32
// (l.333).
extern fn and(bool, bool) -> bool;
extern fn not(bool) -> bool;
extern fn xor(bool, bool) -> bool;
extern fn xor(u8, u8) -> u8;
extern fn xor(u16, u16) -> u16;
extern fn xor(i32, i32) -> i32;
extern fn shl(u8, u8) -> u8;
extern fn shl(u8, u16) -> u8;
extern fn shl(u8, i32) -> u8;
extern fn shl(u16, u8) -> u16;
extern fn shl(u16, u16) -> u16;
extern fn shl(u16, i32) -> u16;
extern fn shl(i32, u8) -> i32;
extern fn shl(i32, u16) -> i32;
extern fn shl(i32, i32) -> i32;
let Pb: bool;
let Qb: bool;
let `p && q`;
`p && q` = and(Pb, Qb) @ `&&`;
let B;
B = not(`p && q`) @ `!`;
let Xu: u16;
let 1: lit 1;
let K;
K = xor(Xu, 1) @ `^`;
let N: u8;
let `2 s`: lit 2;
let S;
S = shl(N, `2 s`) @ `<<`;

must pass;
assert B: bool;
assert `^` == xor#2;
assert K: u16;
assert `<<` == shl#2;
assert S: u8;
