-- main --
=== main ===
     0 |   r0 = ref $order
     1 |   store r0 = r1
     2 |   r2 = ref @item_count
     3 |   r3 = load r2
     5 |   r4 = r3 * 100 (r5)
     6 |   r6 = ref subtotal
     7 |   store r6 = r4
     8 |   r7 = ref subtotal
     9 |   r8 = load r7
    10 |   r9 = ref @discount_rate
    11 |   r10 = load r9
    12 |   r11 = call #0(r8, r10)
    13 |   r12 = ref discount
