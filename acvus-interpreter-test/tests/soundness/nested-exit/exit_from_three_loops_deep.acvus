// expect 112
let find = |c| -> {
    for i in 0u64..c.len() {
        for j in 0u64..c[i].len() {
            for k in 0u64..c[i][j].len() {
                if c[i][j][k] == 9 { return i * 100 + j * 10 + k; };
            }
        }
    }
    999u64
};
find(vec([vec([vec([1, 2]), vec([3])]), vec([vec([4]), vec([5, 6, 9])])]))
