=== main ===
     0 |   r0 = fetch @outer
     1 |   assign @outer = r0
     2 |   r1 = fetch @total
     3 |   assign @total = r1
     4 |   r2 = take @outer
     5 |   r3 = call #0(r2)
     6 |   assign rows = r3
     7 |   jump L0
     8 | L0:
     9 |   r4 = ref &mut rows
    10 |   r5 = call #1(r4)
    11 |   assign $source = r5
    12 |   r6 = ref &$source
    13 |   r7 = test r6 is Some
    14 |   jump_if r7 then L1 else L2
    15 | L1:
    16 |   r8 = take $source.payload
    17 |   assign row = r8
    18 |   r9 = take row
    19 |   r10 = call #0(r9)
    20 |   assign xs = r10
    21 |   jump L3
    22 | L3:
    23 |   r11 = ref &mut xs
    24 |   r12 = call #1(r11)
    25 |   assign $source = r12
    26 |   r13 = ref &$source
    27 |   r14 = test r13 is Some
    28 |   jump_if r14 then L4 else L5
    29 | L4:
    30 |   r15 = take $source.payload
    31 |   assign x = r15
    32 |   r16 = take @total
    33 |   r17 = take x
    34 |   r18 = r16 + r17
    35 |   assign @total = r18
    36 |   jump L3
    37 | L5:
    38 |   jump L0
    39 | L2:
    40 |   r19 = take @total
    41 |   r20 = take @outer
    42 |   commit @outer = r20
    43 |   r21 = take @total
    44 |   commit @total = r21
    45 |   return r19

