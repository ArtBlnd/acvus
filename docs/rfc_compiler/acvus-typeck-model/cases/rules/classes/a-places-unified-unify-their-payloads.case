//@ spec: l.165, with l.74, l.86, l.280, l.284–289, l.301, l.307, l.327
// let mut a = Some(1u8);
// let mut b = Some(2u16);
// let r = if c { &mut a } else { &mut b };
// Neither A nor B is a reference, so each lend's target is its place (l.307).
// R's two lower bounds are &mut references, whose target is invariant, so
// R's target equals A and equals B (l.289), and A and B are unified (l.165).
// Their payloads, the same variant's, are unified in turn (congruence), or
// the one class takes Option once with both lower bounds (l.284–288): either
// way one payload class has the lower bounds u8 and u16, which have no
// common ancestor (l.86), so it has no value (l.280, l.301).
let A;
let S1;
let 1u8: u8;
let `Some(1u8)`: Option<S1>;
let B;
let S2;
let 2u16: u16;
let `Some(2u16)`: Option<S2>;
let `&mut a`;
let `&mut b`;
let R;
S1 = 1u8;
A = `Some(1u8)`;
S2 = 2u16;
B = `Some(2u16)`;
`&mut a` = &mut A @ `lend a`;
`&mut b` = &mut B @ `lend b`;
R = `&mut a`;
R = `&mut b`;

must fail;
assert `lend a` == lend &mut place;
assert `lend b` == lend &mut place;
assert refused no_join `A.Payload(Some)`;
