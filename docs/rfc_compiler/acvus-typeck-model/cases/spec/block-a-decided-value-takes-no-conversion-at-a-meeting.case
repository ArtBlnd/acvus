//@ spec: l.341, l.186, l.215, l.280, l.86
// let mut x = 0u8;
// x = { 1u16 };            // a conversion u16 → u8
// The lambda's result type is u16, decided in its binding group, so it is no
// class of C and its copy is the closed u16 (l.212, l.215). The call's result
// enters X by a meeting, where a value reaches by ≤ and takes no conversion
// (l.280), and u8 ⊔ u16 has no join (l.86): refused at X.
#[conversion] extern fn narrow(u16) -> u8;
group λ in run {
    let `λ result`;
    let 1u16: u16;
    fn λ() -> `λ result`;
    `λ result` = 1u16;
}
let X;
let 0u8: u8;
let `{..}`: lambda λ;
let `{..}()`;
X = 0u8;
`{..}()` = (`{..}`)() @ call;
X = `{..}()`;

must fail;
assert refused no_join X;
assert `{..}()`: u16;
