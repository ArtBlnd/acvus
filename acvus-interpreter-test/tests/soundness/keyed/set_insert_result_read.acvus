// expect 4,1,3
// The result of `insert` reads the entry's state before the call: a chunk would push a key once per chunk that first sees it.
let xs = vec([4, 1, 4, 3, 1, 4]);
let s = hash_set();
let firsts = vec([]);
for x in &xs {
    if s.insert(*x) { firsts.push(*x); };
}
firsts.as_iter().map(|k| -> (*k).to_string()).join(",".to_string())
