//@ spec: l.290, l.171, l.164, l.292
// let x = 3000000000;
// X is unified with the literal's LitVar, its only lower bound (l.171), and no
// source gives it a constructor. At the fixpoint, nothing waits, so it takes
// its family's default, i32 (l.290), which does not hold 3000000000 (l.164):
// refused there (l.292).
let X;
let 3000000000: lit 3000000000;
X = 3000000000;

must fail;
assert refused conflict at "the default of 3000000000";
