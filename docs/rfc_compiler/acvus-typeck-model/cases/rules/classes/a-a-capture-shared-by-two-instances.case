//@ spec: l.188, l.198, l.212, with Example 6 (l.429–443), l.86, l.276, l.292
// let mut last = None;
// let remember = |x| last = Some(x);
// remember(1u8);
// remember(2u16);
// As in Example 6, the write names the capture L, and x's type X is joined to
// it through S, so the write, S and X are the lambda's environment, the
// enclosing binding group's (l.188), and X is no universal (l.212) but one
// class both calls share: each argument meets X itself (l.198), X ≥ u8 and
// X ≥ u16, which have no common ancestor (l.86), so X has no value (l.276,
// l.292).
group λ in run {
    let X;
    let S;
    let `Some(x)`: Option<S>;
    let `λ's ()`: ();
    let `λ result`;
    fn λ(X) -> `λ result`;
    S = X;
}
let L;
let ?k;
let None: Option<?k>;
let `|x| ..`: lambda λ;
let remember;
L = None;
remember = `|x| ..`;
group λ {
    #[by_name] L = `Some(x)`;
    `λ result` = `λ's ()`;
}
let 1u8: u8;
let `remember(1u8)`;
`remember(1u8)` = (remember)(1u8) @ `remember(1u8)`;
let 2u16: u16;
let `remember(2u16)`;
`remember(2u16)` = (remember)(2u16) @ `remember(2u16)`;

must fail;
assert `remember(1u8)` == calls {λ};
assert `remember(2u16)` == calls {λ};
assert refused no_join X;
