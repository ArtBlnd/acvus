//@ spec: l.215, l.196
//@ orders: sampled 200
// let f = adder(1u8); let g = adder(2u16); f(3u8); g(4u16)
// Each instance makes its own copy of the lambda, so the two environments are
// apart: f(3u8) is u8 and g(4u16) is u16.
extern fn core::add(&u8, &u8) -> u8;
extern fn core::add(&u16, &u16) -> u16;
group adder {
    let K;
    let `adder result`;
    fn adder(K) -> `adder result`;
}
group λ in adder {
    let X;
    let `λ result`;
    fn λ(X) -> `λ result`;
    let `&x`;
    let `&k`;
    let S;
    `&x` = &X @ `&x`;
    `λ result` = S;
}
group adder {
    let `|x| x + k`: lambda λ;
    `adder result` = `|x| x + k`;
}
group λ {
    `&k` = &K @ `&k`;
    S = core::add(`&x`, `&k`) @ `x + k`;
}
let 1u8: u8;
let 2u16: u16;
let F;
let G;
let `adder(1u8)`;
let `adder(2u16)`;
`adder(1u8)` = adder(1u8) @ `adder 1`;
F = `adder(1u8)`;
`adder(2u16)` = adder(2u16) @ `adder 2`;
G = `adder(2u16)`;
let 3u8: u8;
let 4u16: u16;
let `f(3u8)`;
let `g(4u16)`;
`f(3u8)` = (F)(3u8) @ `f call`;
`g(4u16)` = (G)(4u16) @ `g call`;

must pass;
assert `f(3u8)`: u8;
assert `g(4u16)`: u16;
