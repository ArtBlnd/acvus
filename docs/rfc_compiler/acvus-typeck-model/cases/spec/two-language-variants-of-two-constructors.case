// let o; if let Some(x) = o { } if let Ok(y) = o { }
// Both patterns are uses of o's value, and the text shows no value entering O.
// O gets no type before the two variants could be compared: no lower bound and
// no occurrence gives it one, and `!` would promise no value where two
// patterns read one.
let O;
let `Some.0`;
let X;
let `Ok.0`;
let Y;
`Some.0` = O as Some @ Some;
X = bind `Some.0` via [Some] @ x;
`Ok.0` = O as Ok @ Ok;
Y = bind `Ok.0` via [Ok] @ y;

must fail;
assert refused no_value O;
