    79 |   r64 = ref final_total
    80 |   r65 = load r64
    81 |   r66 = call #2(r55, r57, r59, r61, r63, r65)
    82 |   r67 = ref receipt
    83 |   store r67 = r66
    84 |   r68 = ref final_total
    85 |   r69 = load r68
    86 |   r70 = ref @total_out
    87 |   store r70 = r69
    88 |   r71 = ref receipt
    89 |   r72 = load r71
    90 |   r73 = ref @receipt_out
    91 |   store r73 = r72
    92 |   r74 = ref receipt
    93 |   r75 = load r74
    94 |   r76 = ref $order
    95 |   r77 = load r76
    96 |   r78 = call #3(r75) [r77 -> r79]
    97 |   r80 = ref $order
    98 |   store r80 = r79
    99 |   r81 = ref final_total
   100 |   r82 = load r81
   101 |   r83 = ref $order
   102 |   r84 = load r83
   103 |   return r82 [r84]

