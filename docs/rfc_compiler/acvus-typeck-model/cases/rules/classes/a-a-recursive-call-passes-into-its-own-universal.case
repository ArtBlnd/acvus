//@ spec: l.194, l.210, with l.195, l.211, l.215, l.219, l.290
// fn g(a) { g(1u8) }       // a module's fn
// g("s")                   // the script
// g's call of itself is a call within its binding group, so it makes no
// instance and takes g's own types (l.194): 1u8 passes into g's A, a universal
// and no unknown (l.210, l.211), the boundary 1u8 ⇝ A, resting on A, in g's C.
// g("s") makes an instance (l.195) whose A' is an unknown the argument meets
// (l.215), &str, and the copied u8 ⇝ &str has no coercion (l.290).
group g {
    let A;
    let `g result`;
    fn g(A) -> `g result`;
    let 1u8: u8;
    let `g(1u8)`;
    `g(1u8)` = g(1u8) @ `g(1u8)`;
    `g result` = `g(1u8)`;
}
let str: str;
let `"s"`: &str;
let `g("s")`;
`g("s")` = g(`"s"`) @ `g("s")`;

must fail;
assert failing [`g@2/1u8 ~> g@2/A`];
