//@ spec: l.154, l.196, design/14-certificate.md
// let v = single(|x| x); let f = v[0]; f(2u8);   // single<T>(T) -> Vec<T>; Vec's view
// v[0] reaches Vec's element along its view (l.154); the checker carries λ's
// Values along the view's signature, where it panicked at a view.
extern type Vec<T>;
#[cast] extern fn core::as_slice<T>(&Vec<T>) -> &[T];
extern fn single<T>(T) -> Vec<T>;
group λ in run {
    let X;
    let `λ result`;
    fn λ(X) -> `λ result`;
    `λ result` = X;
}
let `|x| x`: lambda λ;
let V;
V = single(`|x| x`) @ single;
let `v[0]`;
`v[0]` = V[] @ `v[0]`;
let F;
F = `v[0]`;
let 2u8: u8;
let `f(2u8)`;
`f(2u8)` = (F)(2u8) @ `f call`;

must pass;
assert `f(2u8)`: u8;
