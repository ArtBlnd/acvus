for slice(r8) -> L1 else L2 stages [L1, L7, L8, L9]
// L1: free {take, const, ==, const}
// L7: cycle Carried(r11) any_order law(Op(Or) exact commutative) {const, branch, jump}
// L8: free {take, ==}
// L9: cycle Carried(r12) any_order law(Op(Or) exact commutative) {const, branch, jump}
// control upfront
// cost W=8 O=18293 split when n > 73172, n = len(r8)
