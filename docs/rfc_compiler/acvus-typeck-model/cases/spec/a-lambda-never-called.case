// let x = "s";
// let f = || takes_u8(x);  // takes_u8(u8), f never called
// takes_u8's constraint at its argument, the coercion constraint X ⇝ u8, is the
// lambda's environment, the enclosing group's, recorded whether or not a call
// reaches the lambda, and &str ⇝ u8 fails. Its constraint at
// the result, which writes no variable with the argument, is the lambda's.
extern fn takes_u8(u8);

group λ in run {
    let `λ result`;
    let `takes_u8(x)`;
    fn λ() -> `λ result`;
    `λ result` = `takes_u8(x)`;
}
let str: str;
let `"s"`: &str;
let X;
let `|| ..`: lambda λ;
let f;
X = `"s"`;
f = `|| ..`;
group λ {
    `takes_u8(x)` = takes_u8(X) @ takes_u8;
}

must fail;
assert failing [`X ~> takes_u8.Param(0)`];
