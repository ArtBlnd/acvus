// A reference's node is its mutability and its target's constructor,
// and a declared cast goes from the node it is declared at. A → B and C → B
// declare nothing at (&, A) or (&, C), so &A and &C have no common ancestor
// and no join, and no cast row takes &A to &B; the target is invariant, so no
// other row does either.
extern type A;
extern type B;
extern type C;
#[cast] extern fn a_b(A) -> B;
#[cast] extern fn c_b(C) -> B;

assert join(&A, &C) == none;
assert coerce(&A, &B) == none;
