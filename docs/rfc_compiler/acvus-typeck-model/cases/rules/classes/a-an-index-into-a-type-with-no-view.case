//@ spec: l.161, l.165, with l.68, l.78, l.267, l.301, l.309, l.327
// let o = Some(1u8);
// let x = o[0];
// The projection o[0] reads whether O is a reference; O's only source, its
// lower bound Some(1u8), is an Option, so it applies to O (l.267, l.309),
// whose kind is then the conjunction of Option and "indexes τ" (l.165). An
// Option is structural, not an extern-defined container, so it has no view
// (l.68, l.78), and a type with no view cannot have that kind (l.161): O is
// refused there (l.301).
let O;
let S;
let 1u8: u8;
let `Some(1u8)`: Option<S>;
let `o[0]`;
let X;
S = 1u8;
O = `Some(1u8)`;
`o[0]` = O[] @ `o[0]`;
X = `o[0]`;

must fail;
assert `o[0]` == applied;
assert refused conflict at "the value of O";
