// let mut buf = Vec::new();    // new() -> Vec<T>
// let fill = || fill_all(&mut buf);    // fill_all(&mut Vec<u8>)
// fill();
// The lend and fill_all's constraint at its argument are the enclosing
// group's; fill_all's constraint at the result is the lambda's.
extern type Vec<T>;
extern fn new<T>() -> Vec<T>;
extern fn fill_all(&mut Vec<u8>);

group λ in run {
    let `λ result`;
    let `&mut buf`;
    let `fill_all(..)`;
    fn λ() -> `λ result`;
    `λ result` = `fill_all(..)`;
}
let BUF;
let `new()`;
let `|| ..`: lambda λ;
let fill;
let `fill()`;
`new()` = new() @ new;
BUF = `new()`;
fill = `|| ..`;
`fill()` = (fill)() @ `fill()`;
group λ {
    `&mut buf` = &mut BUF @ lend;
    `fill_all(..)` = fill_all(`&mut buf`) @ fill_all;
}

must pass;
assert BUF: Vec<u8>;
