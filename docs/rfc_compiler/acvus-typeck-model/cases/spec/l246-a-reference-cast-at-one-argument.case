//@ spec: l.246, l.66, l.78, l.109
// f(&a)                    // f(&B), f(&u8); a: A; casts A -> B, &A -> &B
// The common part leaves a reference whole where a whole value passes, since a
// cast goes between two references of one constructor (l.66, l.78): &a meets
// the common part's ?0, and decided as f(&B), &a passes whole into &B by the
// cast (l.109). Split, ?0's target would have been equated with A, and the
// cast lost; adding f(&u8) would have refused what f(&B) alone accepts.
extern type A;
extern type B;
#[cast] extern fn up(A) -> B;
#[cast] extern fn up_ref(&A) -> &B;
extern fn make() -> A;
extern fn f(&B);
extern fn f(&u8);
let X;
let `make()`;
let `&a`;
let R;
`make()` = make() @ make;
X = `make()`;
`&a` = &X @ `&a`;
R = f(`&a`) @ f;

must pass;
assert f == f#0;
