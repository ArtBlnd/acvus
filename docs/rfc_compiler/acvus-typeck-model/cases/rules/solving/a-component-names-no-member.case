// let t;
// t.0 = 1u8;
// The projection t.0 is a use of t's value, and the text shows no value
// entering T. The component it names makes no type, and `!` would promise
// that no value of T exists where the text writes into one. T gets no type.
let T;
let `t.0`;
let 1u8: u8;
`t.0` = T.0 @ `t.0`;
`t.0` = 1u8;

must fail;
assert refused no_value T;
