//@ hole: H3
// let v = make();          // make() -> Vec<u8>; the view as_slice(&Vec<T>) -> &[T]
// take(&v);                // take(&[u8])
// The boundary &V ⇝ &[u8] joins two references, whose constructors are their
// mutabilities alone (l.66), so its target is an equation (l.289), V = [u8],
// and the view's cast is never taken.
extern type Vec<T>;
#[cast] extern fn core::as_slice<T>(&Vec<T>) -> &[T];
extern fn make() -> Vec<u8>;
extern fn take(&[u8]);

let V;
let `make()`;
let `&v`;
let `take(..)`;
`make()` = make() @ make;
V = `make()`;
`&v` = &V @ lend;
`take(..)` = take(`&v`) @ take;

must fail;
assert V: [u8];
