// let x = None;
// let y = if c { x } else { Some(1) };
// take(x); take16(y);      // take(Option<u8>), take16(Option<u16>)
// y's payload has its coercion constraint into u16 left to unify, so P waits for
// it, and its upper bounds are then u16 and u8: no fill, refused in every order.
let X;
let ?k;
let None: Option<?k>;
let Y;
let S;
let 1: lit 1;
let `Some(1)`: Option<S>;
let u8: u8;
let `Option⟨u8⟩`: Option<u8>;
let u16: u16;
let `Option⟨u16⟩`: Option<u16>;
X = None;
Y = X;
S = 1;
Y = `Some(1)`;
`Option⟨u8⟩` = X;
`Option⟨u16⟩` = Y;

must fail;
