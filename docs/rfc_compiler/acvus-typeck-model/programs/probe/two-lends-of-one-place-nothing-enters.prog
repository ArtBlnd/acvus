// from cases/probe/two-lends-of-one-place-nothing-enters.case
// let x; let a = &x; let b = &x;
// Nothing enters X. Each lend reads X leaving out itself alone, and the other
// lend keeps X pending: do the two lends wait for each other at the fixpoint?
lend_a: a <- &x;
lend_b: b <- &x;

assert accepted;
