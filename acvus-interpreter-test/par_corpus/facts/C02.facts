for slice(r14) -> L1 else L2 stages [L1, L7, L8]
// L1: free {take}
// L7: cycle Carried(r15) in_order law(Call(#2, identity) exact commutative) scan {call max}
// L8: cycle Storage(r16) in_order law(Fold(r16, #3) exact) {ref, call push}
// control upfront
// cost W=3 O=18287 split when n > 195062, n = len(r14)
// lower in place: its first stage spawns no heavy or io call before it waits
while r31 -> L6 else L3 stages [L5, L6, L9]
// L5: cycle Storage(r32)+Control in_order {ref, call next, test_variant, while}
// L6: free {unwrap_variant, assign, ref, call to_string}
// L9: cycle Storage(r33) in_order law(Fold(r33, #3) exact) {ref, call push}
// control chained through L5
// cost in place: no count on entry
// lower in place: it is a pull loop
