-- main --
=== main ===
     0 |   assign $order = r0
     1 |   r1 = fetch @item_count
     2 |   assign @item_count = r1
     3 |   r2 = fetch @shipping
     4 |   assign @shipping = r2
     5 |   r3 = fetch @tax_rate
     6 |   assign @tax_rate = r3
     7 |   r4 = fetch @default_ship
     8 |   assign @default_ship = r4
     9 |   r5 = fetch @discount_rate
    10 |   assign @discount_rate = r5
    11 |   r6 = fetch @customer
    12 |   assign @customer = r6
    13 |   r7 = fetch @free_ship_min
    14 |   assign @free_ship_min = r7
    15 |   r8 = take @item_count
    17 |   r9 = r8 * 100 (r10)
    18 |   assign subtotal = r9
    19 |   r11 = take subtotal
    20 |   r12 = take @discount_rate
    21 |   r13 = call #0(r11, r12)
    22 |   assign discount = r13
    23 |   r14 = take subtotal
    24 |   r15 = take discount
    25 |   r16 = r14 - r15
    26 |   r17 = take @tax_rate
    27 |   r18 = call #1(r16, r17)
    28 |   assign tax = r18
    29 |   r19 = take subtotal
    30 |   r20 = take discount
    31 |   r21 = r19 - r20
    32 |   r22 = take tax
    33 |   r23 = r21 + r22
    34 |   assign total = r23
    35 |   r24 = take total
    36 |   r25 = take @free_ship_min
    37 |   r26 = r24 > r25
    38 |   r27 = test r26 == true
    39 |   if r27 -> L0 else L1 join L1
    40 | L0:
    42 |   assign @shipping = 0 (r28)
    43 |   jump L1
    44 | L1:
    46 |   r29 = take total
    47 |   r30 = take @free_ship_min
    48 |   r31 = r29 <= r30
    49 |   r32 = test r31 == true
    50 |   if r32 -> L2 else L3 join L3
    51 | L2:
    52 |   r33 = take @default_ship
    53 |   assign @shipping = r33
    54 |   jump L3
    55 | L3:
    57 |   r34 = take total
    58 |   r35 = take @shipping
    59 |   r36 = r34 + r35
    60 |   assign final_total = r36
    61 |   r37 = take @customer
    62 |   r38 = take subtotal
    63 |   r39 = take discount
    64 |   r40 = take tax
    65 |   r41 = take @shipping
    66 |   r42 = take final_total
    67 |   r43 = call #2(r37, r38, r39, r40, r41, r42)
    68 |   assign receipt = r43
    69 |   r44 = take final_total
    70 |   assign @total_out = r44
    71 |   r45 = take receipt
    72 |   assign @receipt_out = r45
    73 |   r46 = take receipt
    74 |   r47 = take $order
    75 |   r48 = call #3(r46) [r47 -> r49]
    76 |   assign $order = r49
    77 |   r50 = take final_total
    78 |   r51 = take @item_count
    79 |   commit @item_count = r51
    80 |   r52 = take @total_out
    81 |   commit @total_out = r52
    82 |   r53 = take @shipping
    83 |   commit @shipping = r53
    84 |   r54 = take @tax_rate
    85 |   commit @tax_rate = r54
    86 |   r55 = take @default_ship
    87 |   commit @default_ship = r55
    88 |   r56 = take @receipt_out
    89 |   commit @receipt_out = r56
    90 |   r57 = take @discount_rate
    91 |   commit @discount_rate = r57
    92 |   r58 = take @customer
    93 |   commit @customer = r58
    94 |   r59 = take @free_ship_min
    95 |   commit @free_ship_min = r59
    96 |   r60 = take $order
    97 |   return r50 [r60]

