//@ spec: l.339, l.89
//@ orders: sampled 200
// fn f() { let a = get1()?; let b = get2()?; Ok(a) }
// // get1() -> Result<u8, Error{A(A)}>, get2() -> Result<u16, B>
// get1()'s error value is an Error, so it is not wrapped and passes into
// the exit's error part as it is (l.339); B is wrapped into Error{B(..)}.
// The variants unite with no nesting.
extern type A;
extern type B;
extern fn get1() -> Result<u8, Error{A(A)}>;
extern fn get2() -> Result<u16, B>;
group f {
    let `f result`;
    fn f() -> `f result`;
    let `get1()`;
    let A;
    let `exit 1`;
    let `get2()`;
    let B;
    let `exit 2`;
    let S;
    let P;
    let `Ok(a)`: Result<S, P>;
    `get1()` = get1() @ get1;
    A = ?(`get1()`) into `exit 1` @ q1;
    `f result` = `exit 1`;
    `get2()` = get2() @ get2;
    B = ?(`get2()`) into `exit 2` @ q2;
    `f result` = `exit 2`;
    S = A;
    `f result` = `Ok(a)`;
}
let `f()`;
`f()` = f() @ `f()`;

must pass;
assert `f()`: Result<u8, Error{A(A), B(B)}>;
