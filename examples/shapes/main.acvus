// A structural enum of three shapes: `Shape::Circle`, `Shape::Square` and
// `Shape::Rect` are introduced by being written, and the `match` that
// measures one is exhaustive over them.
// An entry whose kind is none of the three becomes an `Err`, `measure`
// carries that `Err` outward with `?`, and the largest area is an `Option`
// because an empty list has none.

let pi = 3.141592653589793;

let measure = |parsed| -> {
    let shape = parsed?;
    let m = match shape {
        Shape::Circle(r) => { area: pi * r * r, perimeter: 2.0 * pi * r, },
        Shape::Square(s) => { area: s * s, perimeter: 4.0 * s, },
        Shape::Rect((w, h)) => { area: w * h, perimeter: 2.0 * (w + h), },
    };
    Ok(m)
};

let areas = vec([]);
let total_area = 0.0;
let total_perimeter = 0.0;
let refused = vec([]);

for e in &@entries {
    let parsed = if e.kind == "circle" {
        Ok(Shape::Circle(e.a))
    } else if e.kind == "square" {
        Ok(Shape::Square(e.a))
    } else if e.kind == "rect" {
        Ok(Shape::Rect((e.a, e.b)))
    } else {
        Err(e.kind.to_string())
    };

    let measured = measure(parsed);
    match measured {
        Ok(m) => {
            total_area = total_area + m.area;
            total_perimeter = total_perimeter + m.perimeter;
            areas.push(m.area);
        },
        Err(bad) => {
            refused.push(bad);
        },
    };
}

let largest = (areas.into_iter() | max).unwrap_or(0.0);

let out = "measured {{ &total_area | to_string }} area, {{ &total_perimeter | to_string }} perimeter
largest {{ &largest | to_string }}";

for refused_kind in &refused {
    let kind = refused_kind.to_string();
    out = out + "
refused {{ &kind }}";
}
out
