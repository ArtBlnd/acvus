// expect "jumps over the lazy dog, again and again"
// while let with literal and binding over pops of Large tuples
let v = vec([("the quick brown fox jumps over it".to_string(), 1), ("jumps over the lazy dog, again and again".to_string(), 2)]); let s = "".to_string(); while let Some((t, 2)) = v.pop() { s = t; } s
