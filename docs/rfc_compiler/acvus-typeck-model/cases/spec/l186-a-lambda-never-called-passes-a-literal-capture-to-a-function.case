//@ spec: l.186, l.215
// fn put2(a, b) { takes_u8(a) }   // takes_u8(u8)
// let x = 0;
// let f = |y| put2(x, y);   // f never called
// The use's constraint at x is the environment's, recorded whether or not a
// call reaches the lambda: its instance of put2 makes what C ties to a, so
// x meets a, which passes into u8, and x is u8 (l.186, l.215).
extern fn takes_u8(u8);
group put2 {
    let A;
    let B;
    let `put2 result`;
    fn put2(A, B) -> `put2 result`;
    let `takes_u8(a)`;
    `takes_u8(a)` = takes_u8(A) @ takes_u8;
    `put2 result` = `takes_u8(a)`;
}
group λ in run {
    let Y;
    let `λ result`;
    fn λ(Y) -> `λ result`;
    let `put2(..)`;
    `λ result` = `put2(..)`;
}
let 0: lit 0;
let X;
X = 0;
let `|y| ..`: lambda λ;
let F;
F = `|y| ..`;
group λ {
    `put2(..)` = put2(X, Y) @ `put2 call`;
}

must pass;
assert X: u8;
