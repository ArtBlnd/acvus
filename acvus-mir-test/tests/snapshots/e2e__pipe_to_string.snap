=== main ===
     0 |   r0 = fetch @n
     1 |   assign @n = r0
     2 |   r1 = ref &@n
     3 |   r2 = call #0(r1)
     4 |   r3 = string_concat [r2]
     5 |   r4 = take @n
     6 |   commit @n = r4
     7 |   return r3

    ; r0 (@n) : Int
