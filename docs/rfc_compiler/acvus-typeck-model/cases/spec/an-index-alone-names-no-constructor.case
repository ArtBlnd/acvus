//@ spec: l.154, l.274, l.276, l.288
// let a;
// a[0] = 1;
// The kind "indexes τ" names no member, so A has no source that gives a
// constructor and falls back to !, whose element is ! (l.276): the literal
// entering it has no type there.
let A;
let `a[0]`;
let 1: lit 1;
`a[0]` = A[] @ `a[0]`;
`a[0]` = 1;

must fail;
