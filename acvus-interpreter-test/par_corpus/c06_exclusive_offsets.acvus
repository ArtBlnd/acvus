// id: C06
// family: scan
// desc: exclusive scan of lengths into offsets: push the total, then add the length
// expect: 0,3,7,8
let words = vec(["fig".to_string(), "pear".to_string(), "a".to_string(), "kiwi".to_string()]);
let total = 0u64;
let offs = vec([]);
for w in &words {
    offs.push(total);
    total = total + w.len();
}
offs.into_iter().map(|x| -> x.to_string()).join(",".to_string())
