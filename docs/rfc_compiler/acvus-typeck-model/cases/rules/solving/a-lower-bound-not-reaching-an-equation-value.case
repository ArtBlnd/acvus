//@ spec: l.293, l.301; Example 3, l.391–405, without the conversion
// let mut buf = Vec::new();
// push(&mut buf, 1u16);    // push(&mut Vec<T>, T)
// consume(buf);            // consume(Vec<u8>)
// push's T is an unknown that 1u16 meets, T ≥ u16; the two invariant arguments
// make T's value the u8 the equations give (l.279). The lower bound u16 does
// not reach u8 by ≤, so it must reach it by a coercion (l.293), and none goes
// from u16 to u8: refused at that lower bound (l.301).
extern type Vec<T>;
extern fn new<T>() -> Vec<T>;
extern fn push<T>(&mut Vec<T>, T);
extern fn consume(Vec<u8>);

let B;
let `new()`;
let `&mut buf`;
let 1u16: u16;
let `push(..)`;
let `consume(..)`;
`new()` = new() @ new;
B = `new()`;
`&mut buf` = &mut B @ lend;
`push(..)` = push(`&mut buf`, 1u16) @ push;
`consume(..)` = consume(B) @ consume;

must fail;
assert B: Vec<u8>;
assert push == push#0;
assert lend == lend &mut place;
assert failing [`1u16 ≤ push.Var(Type(0))`];
