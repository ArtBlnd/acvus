for slice(r16) -> L1 else L2 stages [L1, L7, L8, L9]
// L1: free {call indirect, assign, take}
// L7: cycle Storage(r18) any_order law(Op(Add) exact commutative) {take, +, assign}
// L8: free {const_str, ref, concat, drop, assign, ref, const_str, concat, drop}
// L9: cycle Storage(r19) in_order law(Fold(r19, #2) exact) {ref, call push}
// control upfront
// cost W=58 O=18293 split when n > 10093, n = len(r16)
while r64 -> L6 else L3 stages [L5, L6, L10]
