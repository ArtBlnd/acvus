// let o; if let Some(x) = o { } if let Ok(y) = o { }
// The structure constraints name members of Option and of Result, two constructors with no
// join: O has no value, refused.
let O;
let `Some.0`;
let X;
let `Ok.0`;
let Y;
`Some.0` = O as Some @ Some;
X = bind `Some.0` via [Some] @ x;
`Ok.0` = O as Ok @ Ok;
Y = bind `Ok.0` via [Ok] @ y;

must fail;
assert refused no_join O;
