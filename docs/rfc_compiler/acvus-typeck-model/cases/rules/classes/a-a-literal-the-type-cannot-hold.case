//@ spec: l.164, with l.129, l.221, l.280, l.292
// @n = 256;                // @n is the host's u8
// The literal's type is ?{256} (l.129), and the store is the boundary
// 256 ⇝ @n (l.213, l.221), which unifies ?{256} with u8 (l.280). l.164 asks
// the constructor to hold every value in N: u8 does not hold 256, so the
// unification gives no result, and the program is refused there (l.292).
let `@n`: host u8;
let 256: lit 256;
`@n` = 256;

must fail;
assert refused conflict at "256 = @n";
