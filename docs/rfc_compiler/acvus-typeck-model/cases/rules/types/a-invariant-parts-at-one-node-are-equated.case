// Vec's argument and a reference's target are invariant, and the
// relation between invariant parts is an equation. A = C fails, so Vec<A> and
// Vec<C> have no join. After the reborrow, Option<A> sits behind a reference,
// whose target is invariant, and A = B fails.
extern type A;
extern type B;
extern type C;
extern type Vec<T>;
#[cast] extern fn a_b(A) -> B;
#[cast] extern fn c_b(C) -> B;

assert join(Vec<A>, Vec<C>) == none;
assert coerce(Vec<A>, Vec<B>) == none;
assert coerce(&mut Option<A>, &Option<B>) == none;
