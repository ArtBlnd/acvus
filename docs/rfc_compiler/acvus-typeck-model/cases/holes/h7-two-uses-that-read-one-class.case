//@ spec: Example 12, l.539–557, followed by probe(x)
//@ hole: H7
// probe and x + y both read X, each lying at a position the other reads, so
// each breaks its dependency on the other (l.250, l.269), and probe reads X
// without x + y's relations, as ?a alone, takes the default i32, and is
// refused in every order.
extern fn core::add(&u8, &u8) -> u8;
extern fn core::add(&u16, &u16) -> u16;
extern fn core::add(&i32, &i32) -> i32;
extern fn probe(u16);
extern fn probe(i32);

let X;
let ?a: lit 0;
let Y;
let 1u16: u16;
let ?b: lit 1;
let `&x`;
let `&y`;
let R1;
let `&y 2`;
let `&1`;
let R2;
let `probe(x)`;
X = ?a;
Y = 1u16;
`&x` = &X @ `&x`;
`&y` = &Y @ `&y`;
R1 = core::add(`&x`, `&y`) @ `x + y`;
X = R1;
`&y 2` = &Y @ `&y 2`;
`&1` = &?b @ `&1`;
R2 = core::add(`&y 2`, `&1`) @ `y + 1`;
Y = R2;
`probe(x)` = probe(X) @ probe;

must fail;
assert probe == probe#1;
assert istar completeness probe;
