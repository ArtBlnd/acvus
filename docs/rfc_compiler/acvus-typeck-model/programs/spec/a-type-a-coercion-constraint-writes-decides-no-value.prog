// from cases/spec/a-type-a-coercion-constraint-writes-decides-no-value.case
// let mut buf = Vec::new();
// push(&mut buf, 1u16);    // push(&mut Vec<T>, T)
// consume(buf);            // consume(Vec<u8>)
// not asserted here: assert failing [`B ~> consume.Param(0)`];
row narrow: u16 -> u8;
one_u16 <- u16;
declare new_result = Vec<new_t>;
new <- new_result;
b <- new;
lend: ref_mut_buf <- &mut b;
declare push_p0 = &mut Vec<push_t>;
declare push_p1 = push_t;
declare push_result = ();
push_0: pass ref_mut_buf to push_p0;
push_1: pass one_u16 to push_p1;
push <- push_result;
declare consume_p0 = Vec<u8>;
declare consume_result = ();
consume_0: pass b to consume_p0;
consume <- consume_result;

// A decomposition records the coercion constraint ?t ~> u8 toward a type the declaration writes,
// which decides no value, and u16 enters ?t: B is Vec<u16>,
// which reaches Vec<u8> by no coercion at consume(buf), the conversion taking
// no part.
assert refused ..;
assert b: Vec<u16>;
