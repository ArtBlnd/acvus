//@ spec: Example 3, l.391–405, with the declared conversion u16 → u8
// let mut buf = Vec::new();
// push(&mut buf, 1u16);    // push(&mut Vec<T>, T)
// consume(buf);            // consume(Vec<u8>)
extern type Vec<T>;
extern fn new<T>() -> Vec<T>;
extern fn push<T>(&mut Vec<T>, T);
extern fn consume(Vec<u8>);
#[conversion] extern fn narrow(u16) -> u8;

let B;
let `new()`;
let `&mut buf`;
let 1u16: u16;
let `push(..)`;
let `consume(..)`;
`new()` = new() @ new;
B = `new()`;
`&mut buf` = &mut B @ lend;
`push(..)` = push(`&mut buf`, 1u16) @ push;
`consume(..)` = consume(B) @ consume;

must pass;
assert B: Vec<u8>;
assert check `1u16 ≤ push.Var(Type(0))` == conversion narrow#0;
