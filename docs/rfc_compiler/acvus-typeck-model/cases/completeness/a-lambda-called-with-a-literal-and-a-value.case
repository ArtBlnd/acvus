//@ orders: sampled 200
// let f = |acc, s| acc + s;
// f(0, one())              // one() -> i32
// As a-fold-from-a-literal, the lambda called instead of passed into a
// function type: the call makes its instance.
extern fn one() -> i32;
extern fn core::add(&i32, &i32) -> i32;
extern fn core::add(&i64, &i64) -> i64;
group λ in run {
    let ACC;
    let S;
    let `λ result`;
    fn λ(ACC, S) -> `λ result`;
    let `&acc`;
    `&acc` = &ACC @ `&acc`;
    let `&s`;
    `&s` = &S @ `&s`;
    let `acc + s`;
    `acc + s` = core::add(`&acc`, `&s`) @ add;
    `λ result` = `acc + s`;
}
let `|acc, s| ..`: lambda λ;
let F;
F = `|acc, s| ..`;
let 0: lit 0;
let `one()`;
`one()` = one() @ one;
let `f(..)`;
`f(..)` = (F)(0, `one()`) @ `f 1`;

must pass;
assert outcomes 1;
assert `f(..)`: i32;
assert 0: i32;
