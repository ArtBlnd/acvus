//@ spec: l.261, l.320–333
// f reads x as u8, which leaves f(u8) alone; decided, it records its argument
// passing into its parameter's type, a boundary, and its result type entering
// the use's result, a lower bound.
//@ order: decide f
extern fn f(u8) -> u8;
extern fn f(u16) -> u16;

let x: u8;
let R;
R = f(x) @ f;

assert trace "decide f: f#0";
assert node records `x ~> f.Param(0)`;
assert node records `f.Result <= R`;
must pass;
assert R: u8;
