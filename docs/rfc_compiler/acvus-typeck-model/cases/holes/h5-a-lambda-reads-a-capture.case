//@ hole: H5
// let x = make();          // make() -> A
// let f = || probe(x);     // probe(A), probe(B)
// f();
// The lambda's group is solved before the enclosing one (l.215), and no
// dependency makes its probe wait for what the enclosing group records into X
// (l.211, l.240–246), so probe reads X as nothing: the position decides
// nothing, both candidates remain, and probe is not decided (l.263, l.335). It
// stays in C (l.214) and is decided in the copy the call makes, where X is A.
extern type A;
extern type B;
extern fn make() -> A;
extern fn probe(A);
extern fn probe(B);

group λ in run {
    let `λ result`;
    let `probe(x)`;
    fn λ() -> `λ result`;
    `λ result` = `probe(x)`;
}
let X;
let `make()`;
let `|| ..`: lambda λ;
let f;
let `f()`;
`make()` = make() @ make;
X = `make()`;
f = `|| ..`;
`f()` = (f)() @ `f()`;
group λ {
    `probe(x)` = probe(X) @ probe;
}

must pass;
assert `f()#λ/probe` == probe#0;
