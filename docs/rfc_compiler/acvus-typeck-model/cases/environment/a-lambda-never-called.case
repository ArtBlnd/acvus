//@ spec: design/17-environment.md
// let x = "s";
// let f = || takes_u8(x);  // takes_u8(u8), f never called
// Read by the captured environment (row 1), takes_u8 and its boundary are the
// enclosing group's, recorded whether or not a call reaches the lambda, and
// &str ⇝ u8 fails (l.279).
//@ reading: captures = environment
extern fn takes_u8(u8);

group λ in run {
    let `λ result`;
    let `takes_u8(x)`;
    fn λ() -> `λ result`;
    `λ result` = `takes_u8(x)`;
}
let str: str;
let `"s"`: &str;
let X;
let `|| ..`: lambda λ;
let f;
X = `"s"`;
f = `|| ..`;
group λ {
    `takes_u8(x)` = takes_u8(X) @ takes_u8;
}

must fail;
assert failing [`X ~> takes_u8.Param(0)`];
