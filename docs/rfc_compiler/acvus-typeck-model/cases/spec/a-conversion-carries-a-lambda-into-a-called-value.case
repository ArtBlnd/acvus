// let b = boxed(|y| want16(y)); let r: Rc<P> = b; P = |x| x; let f = unwrap(r); f(2u8);
// to_rc<T>(Box<T>) -> Rc<T> a conversion. f's Values name λ alone, so the call
// makes no instance of μ, while r holds μ, which would take 2u8 into want16's
// u16. The conversion carries μ to P, whose Values do not name it: B does not
// reach R, and the program is refused there.
extern type Box<T>;
extern type Rc<T>;
extern fn boxed<T>(T) -> Box<T>;
#[conversion] extern fn to_rc<T>(Box<T>) -> Rc<T>;
extern fn unwrap<T>(Rc<T>) -> T;
extern fn want16(u16) -> u16;
group λ in run {
    let X;
    let `λ result`;
    fn λ(X) -> `λ result`;
    `λ result` = X;
}
group μ in run {
    let Y;
    let `μ result`;
    fn μ(Y) -> `μ result`;
    `μ result` = want16(Y) @ want16;
}
let `|x| x`: lambda λ;
let `|y| want16(y)`: lambda μ;
let B;
B = boxed(`|y| want16(y)`) @ boxed;
let P;
let R: Rc<P>;
R = B;
P = `|x| x`;
let F;
F = unwrap(R) @ unwrap;
let 2u8: u8;
let `f(2u8)`;
`f(2u8)` = (F)(2u8) @ `f call`;

must fail;
assert failing [`B ~> R`];
