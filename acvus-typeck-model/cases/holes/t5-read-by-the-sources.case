//@ hole: T5
// let a = @cfg;            // @cfg is { name: String }, given by the host
// a.extra = 1;
// Read by the sources, a lower bound the host gives makes no member visible,
// and the kind conflicts with {name}.
//@ reading: visibility = by_sources

let String: String;
let `@cfg`: host {name: String};
let A;
let `a.extra`;
let 1: lit 1;
A = `@cfg`;
`a.extra` = A.extra @ `a.extra`;
`a.extra` = 1;

must fail;
