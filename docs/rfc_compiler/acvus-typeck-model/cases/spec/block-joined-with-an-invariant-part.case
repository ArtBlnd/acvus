//@ spec: l.341, l.186, l.215, l.86, l.278
// let x = if c { { Vec::new() } } else { make() };   // make() -> Vec<u8>
// new's T is left in the lambda's C and copied by the call's instance
// (l.215). X joins the two Vecs, and a Vec's argument is invariant, so the
// splits equate the copy of T with u8 (l.278).
extern type Vec<T>;
extern fn new<T>() -> Vec<T>;
extern fn make() -> Vec<u8>;
group λ in run {
    let `λ result`;
    let `new()`;
    fn λ() -> `λ result`;
    `λ result` = `new()`;
}
let X;
let `make()`;
let `{..}`: lambda λ;
let `{..}()`;
`{..}()` = (`{..}`)() @ call;
X = `{..}()`;
`make()` = make() @ make;
X = `make()`;
group λ {
    `new()` = new() @ new;
}

must pass;
assert X: Vec<u8>;
