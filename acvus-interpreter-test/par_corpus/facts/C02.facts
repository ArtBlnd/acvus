for slice(r14) -> L1 else L2 stages [L1, L3, L4]
// L1: free {take}
// L3: cycle Carried(r15) in_order law(Call(#2, identity) exact commutative) scan {call max}
// L4: cycle Storage(r16) in_order law(Fold(r16, #3) exact) {ref, call push}
// control upfront
// cost W=3 O=18287 split when n > 195062, n = len(r14)
