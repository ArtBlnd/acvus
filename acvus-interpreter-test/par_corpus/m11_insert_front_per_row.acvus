// id: M11
// family: map-filter
// desc: M07's reversed map run per row: the outer loop's iteration-local `out` and the whole insert loop sit in the outer free stage
// expect: 16,6,10;4,2;14
let rows = vec([vec([5, 3, 8]), vec([1, 2]), vec([7])]);
let shown = vec([]);
for row in &rows {
    let out = vec([]);
    for i in 0u64..row.len() {
        out.insert(0u64, row[i] * 2);
    }
    shown.push(out.into_iter().map(|x| -> x.to_string()).join(",".to_string()));
}
shown.into_iter().join(";".to_string())
