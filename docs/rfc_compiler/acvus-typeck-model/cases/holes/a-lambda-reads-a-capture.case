// let x = make();          // make() -> A
// let f = || probe(x);     // probe(A), probe(B)
// f();
// probe's choice of a candidate is its constraint at the capture X, so it is
// the lambda's environment, the enclosing group's, and reads X as A;
// its constraint at the result, () for both, is the lambda's.
extern type A;
extern type B;
extern fn make() -> A;
extern fn probe(A);
extern fn probe(B);

group λ in run {
    let `λ result`;
    let `probe(x)`;
    fn λ() -> `λ result`;
    `λ result` = `probe(x)`;
}
let X;
let `make()`;
let `|| ..`: lambda λ;
let f;
let `f()`;
`make()` = make() @ make;
X = `make()`;
f = `|| ..`;
`f()` = (f)() @ `f()`;
group λ {
    `probe(x)` = probe(X) @ probe;
}

must pass;
assert probe == probe#0;
