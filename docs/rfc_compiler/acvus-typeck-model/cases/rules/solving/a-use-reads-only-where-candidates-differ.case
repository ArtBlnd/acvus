//@ spec: l.263, l.326, l.328–335, l.282, l.292
// let b = make();          // make() -> B
// f(1u8, b);               // f(u8, A) -> u8, f(u16, A) -> u16
// The candidates differ only at the first argument, so f reads that position
// alone (l.263); 1u8 leaves f(u8, A) (l.328–335). The second parameter, A, is
// what both candidates share, so b ⇝ A holds at once (l.326). B reaches A by no
// coercion (l.282): refused at that boundary (l.292), with f decided.
extern type A;
extern type B;
extern fn make() -> B;
extern fn f(u8, A) -> u8;
extern fn f(u16, A) -> u16;

let `make()`;
let X;
let 1u8: u8;
let `f(..)`;
`make()` = make() @ make;
X = `make()`;
`f(..)` = f(1u8, X) @ f;

must fail;
assert f == f#0;
assert X: B;
assert failing [`X ~> f.Param(1)`];
