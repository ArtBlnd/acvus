// let mut x = 1;
// x = 1.5;
// The initializer and the assignment are lower bounds, 1 <= X and 1.5 <= X.
// X has no equation, so its value is the join of its sources,
// and a LitVar's join unifies it with X. Two LitVars of two families
// have no rule, so the join has no result: X has no value, and the
// program is refused there.
let X;
let 1: lit 1;
let `1.5`: lit 1.5;
X = 1;
X = `1.5`;

must fail;
assert X: none;
assert refused conflict at "1.5 = X";
