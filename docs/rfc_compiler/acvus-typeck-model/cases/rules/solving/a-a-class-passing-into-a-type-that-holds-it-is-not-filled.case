//@ spec: l.280, l.284, l.290, l.282
// let a;
// f(&a, &a);               // f<T>(&T, &Vec<T>)
// Each lend's target is A, which is a reference in no reading. Each argument
// passes into a reference the declaration gives, a boundary, whose split links
// the targets (l.280): toward the unknown T, an equation A = T; toward the
// written Vec<T>, the boundary A ⇝ Vec<T>. Nothing enters A, and the one place
// it passes into, Vec<T>, has a value only once A has one, so A is not filled
// (l.284) and falls back to ! (l.290). &! reaches &Vec<!> by no coercion
// (l.282).
extern type Vec<T>;
extern fn f<T>(&T, &Vec<T>);

let A;
let `&a 1`;
let `&a 2`;
let `f(..)`;
`&a 1` = &A @ `lend 1`;
`&a 2` = &A @ `lend 2`;
`f(..)` = f(`&a 1`, `&a 2`) @ f;

must fail;
assert A: !;
assert failing [`&a 2 ~> f.Param(1)`];
