//@ spec: Example 7, l.444–459, the write in a lambda; l.188
// let mut x = None;
// let r = &mut x;
// let f = || *r = Some(1u8);
// f();
// The write names the capture R, so it is the lambda's environment, recorded
// in the enclosing group (l.188), and through the captured r it is a boundary
// (l.458), whose payload, an unknown of that group, takes a lower bound
// (l.280).
group λ in run {
    let `*r`;
    let S;
    let `Some(1u8)`: Option<S>;
    let 1u8: u8;
    let `()`: ();
    let `λ result`;
    fn λ() -> `λ result`;
    S = 1u8;
    `λ result` = `()`;
}
let X;
let ?k;
let None: Option<?k>;
let `&mut x`;
let R;
let `|| ..`: lambda λ;
let f;
let `f()`;
X = None;
`&mut x` = &mut X @ `&mut x`;
R = `&mut x`;
f = `|| ..`;
`f()` = (f)() @ `f()`;
group λ {
    `*r` = *R @ `*r`;
    #[through_ref] `*r` = `Some(1u8)`;
}

must pass;
assert X: Option<u8>;
