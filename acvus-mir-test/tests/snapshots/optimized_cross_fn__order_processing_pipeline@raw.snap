    32 |   r29 = r26 + r28
    33 |   r30 = ref total
    34 |   store r30 = r29
    35 |   r31 = ref total
    36 |   r32 = load r31
    37 |   r33 = ref @free_ship_min
    38 |   r34 = load r33
    39 |   r35 = r32 > r34
    40 |   r36 = test r35 == true
    41 |   jump_if r36 then L0 else L1
    42 | L0:
    44 |   r37 = ref @shipping
    45 |   store r37 = 0 (r38)
    46 |   jump L1
    47 | L1:
    48 |   r39 = ref total
    49 |   r40 = load r39
    50 |   r41 = ref @free_ship_min
    51 |   r42 = load r41
    52 |   r43 = r40 <= r42
    53 |   r44 = test r43 == true
    54 |   jump_if r44 then L2 else L3
    55 | L2:
    56 |   r45 = ref @default_ship
    57 |   r46 = load r45
    58 |   r47 = ref @shipping
    59 |   store r47 = r46
    60 |   jump L3
    61 | L3:
    62 |   r48 = ref total
    63 |   r49 = load r48
    64 |   r50 = ref @shipping
    65 |   r51 = load r50
    66 |   r52 = r49 + r51
    67 |   r53 = ref final_total
    68 |   store r53 = r52
    69 |   r54 = ref @customer
