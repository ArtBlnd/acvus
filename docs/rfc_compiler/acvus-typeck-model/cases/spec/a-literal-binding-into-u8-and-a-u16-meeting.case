// let a = 1; takes_u8(a); let x = a; x = 2u16;
// x waits for its lower bound a, which is unified with u8 by its boundary
// before x is joined, so x has no join of u8 and u16 in every order.
extern fn takes_u8(u8);
let 1: lit 1;
let A;
A = 1;
let `takes_u8(a)`;
`takes_u8(a)` = takes_u8(A) @ takes_u8;
let X;
X = A;
let 2u16: u16;
X = 2u16;

must fail;
