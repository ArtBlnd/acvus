// let x = 1u8;
// let f = |y| pair(x, y);   // pair<A, B>(A, B)
// f(2u8); f("s");
// A and B are apart, so the use gives a constraint at each argument: at x the
// environment's, at y the lambda's, each call typing y by what it passes.
extern fn pair<A, B>(A, B);
group λ in run {
    let Y;
    let `λ result`;
    fn λ(Y) -> `λ result`;
    let `pair(..)`;
    `λ result` = `pair(..)`;
}
let 1u8: u8;
let X;
X = 1u8;
let `|y| ..`: lambda λ;
let F;
F = `|y| ..`;
let 2u8: u8;
let Str: str;
let s: &Str;
let `f(2u8)`;
let `f(s)`;
`f(2u8)` = (F)(2u8) @ `f 1`;
`f(s)` = (F)(s) @ `f 2`;
group λ {
    `pair(..)` = pair(X, Y) @ pair;
}

must pass;
