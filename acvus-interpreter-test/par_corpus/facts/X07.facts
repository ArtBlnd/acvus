for slice(r2) -> L1 else L2 stages [L1, L5, L6, L7]
// L1: free {take}
// L5: cycle Carried(r6) any_order law(Op(Add) exact commutative) {+}
// L6: free {take, const, >}
// L7: cycle Carried(r5) any_order law(Op(Add) exact commutative) {const, +, branch, jump}
// control upfront
// cost W=7 O=18293 split when n > 83626, n = len(r2)
