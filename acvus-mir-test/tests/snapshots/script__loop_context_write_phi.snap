=== main ===
     0 |   r0 = fetch @items
     1 |   assign @items = r0
     2 |   r1 = fetch @count
     3 |   assign @count = r1
     4 |   r2 = take @items
     5 |   r3 = call #0(r2)
     6 |   assign it = r3
     7 |   jump L0
     8 | L0:
     9 |   r4 = ref &mut it
    10 |   r5 = call #1(r4)
    11 |   r6 = test r5 is Some
    12 |   jump_if r6 then L1 else L2
    13 | L1:
    14 |   r7 = unwrap r5
    15 |   assign x = r7
    16 |   r8 = take @count
    18 |   r9 = r8 + 1 (r10)
    19 |   assign @count = r9
    20 |   jump L0
    21 | L2:
    22 |   r11 = take @count
    23 |   r12 = take @items
    24 |   commit @items = r12
    25 |   r13 = take @count
    26 |   commit @count = r13
    27 |   return r11

    ; r0 (@items) : Array<Int, 3>
