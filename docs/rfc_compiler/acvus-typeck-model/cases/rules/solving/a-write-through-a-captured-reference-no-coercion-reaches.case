//@ spec: l.188, l.221, l.230, l.276, l.282, l.292
// let mut x = 1u8;
// let r = &mut x;
// let f = || *r = 2u16;
// f();
// The write in the lambda names the capture R, so it is the lambda's
// environment, recorded in the enclosing group (l.188), and it reaches X, an
// unknown of that group, through the reference r, so it is a boundary,
// 2u16 ⇝ *r (l.221, l.230), and the Deref makes *r X. A boundary is no source (l.276), so X is u8, from 1u8
// alone, and the value entering by the boundary reaches u8 by no coercion
// (l.282): refused at that boundary (l.292).
group λ in run {
    let `*r`;
    let 2u16: u16;
    let `()`: ();
    let `λ result`;
    fn λ() -> `λ result`;
    `λ result` = `()`;
}
let X;
let 1u8: u8;
let `&mut x`;
let R;
let `|| ..`: lambda λ;
let f;
let `f()`;
X = 1u8;
`&mut x` = &mut X @ `&mut x`;
R = `&mut x`;
f = `|| ..`;
`f()` = (f)() @ `f()`;
group λ {
    `*r` = *R @ `*r`;
    #[through_ref] `*r` = 2u16;
}

must fail;
assert X: u8;
assert `&mut x` == lend &mut place;
assert `f()` == calls {λ};
assert failing [`2u16 ~> *r`];
