// Word counts over the context text: `split_whitespace` cuts it, `lower`
// folds the case, and a trailing period or comma is stripped with
// `strip_suffix`.
// The top three words come out by count descending and, where counts tie,
// by the word's bytes ascending -- there is no ordering on `String`, so
// the tiebreak compares `to_bytes` element by element.

let bare = |w| -> {
    let no_stop = w.strip_suffix(".").unwrap_or(w);
    let no_comma = no_stop.strip_suffix(",").unwrap_or(no_stop);
    no_comma
};

let bytes_lt = |a, b| -> {
    let shorter = if a.len() < b.len() { a.len() } else { b.len() };
    let verdict = 0;
    for i in 0u64..shorter {
        if a[i] < b[i] {
            verdict = 0 - 1;
            break;
        } else if b[i] < a[i] {
            verdict = 1;
            break;
        };
    }
    let tied = verdict == 0;
    let answer = if tied { a.len() < b.len() } else { verdict < 0 };
    answer
};

let words = vec([]);
let tally = vec([]);
let total = 0;

let raw = &@text | split_whitespace;
while let Some(token) = raw.next() {
    let word = bare(token.lower());
    total = total + 1;
    let seen = false;
    for i in 0u64..words.len() {
        if words[i] == word {
            tally[i] = tally[i] + 1;
            seen = true;
            break;
        };
    }
    if !seen {
        words.push(word);
        tally.push(1);
    };
}

for i in 0u64..words.len() {
    let best = i;
    for j in i + 1u64..words.len() {
        let ahead = if tally[j] > tally[best] {
            true
        } else {
            let tied = tally[j] == tally[best];
            let by_name = if tied {
                bytes_lt(words[j].to_string().to_bytes(), words[best].to_string().to_bytes())
            } else {
                false
            };
            by_name
        };
        if ahead {
            best = j;
        };
    }
    words.swap(i, best);
    tally.swap(i, best);
}

let distinct = words.len();
let wanted = 3u64;
let shown = if distinct < wanted { distinct } else { wanted };

let out = "{{ &total | to_string }} words, {{ &distinct | to_string }} distinct, top {{ &shown | to_string }}:";
for k in 0u64..shown {
    let word = words[k].to_string();
    let count = tally[k];
    out = out + "
{{ &word }} {{ &count | to_string }}";
}
out
