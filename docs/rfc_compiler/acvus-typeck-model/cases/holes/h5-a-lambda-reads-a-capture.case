//@ hole: H5
// let x = make();          // make() -> A
// let f = || probe(x);     // probe(A), probe(B)
// f();
// The lambda's group is solved before the enclosing one (l.220), and no
// dependency makes its probe wait for what the enclosing group records into X
// (l.216, l.244–250), so probe reads X as nothing and is refused. I* decides
// probe(A), reading what the call's instance and an instance of the check's own
// record into X.
extern type A;
extern type B;
extern fn make() -> A;
extern fn probe(A);
extern fn probe(B);

group λ in run {
    let `λ result`;
    let `probe(x)`;
    fn λ() -> `λ result`;
    `λ result` = `probe(x)`;
}
let X;
let `make()`;
let `|| ..`: lambda λ;
let f;
let `f()`;
`make()` = make() @ make;
X = `make()`;
f = `|| ..`;
`f()` = (f)() @ `f()`;
group λ {
    `probe(x)` = probe(X) @ probe;
}

must fail;
assert probe == unreached;
assert istar completeness `f()#λ/probe`;
assert istar completeness `λ#check/probe`;
