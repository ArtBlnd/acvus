//@ spec: l.116, l.337, l.344
// f(make());               // make() -> {x: u8, y: u8}; f({x: u8}), f({y: u8})
// Each candidate is reached by narrowing {x: u8, y: u8} to one field: one
// structural step, no cast, no lower stage (l.107, l.116). The ranks are
// equal, so both remain; the result passes into a class that decides nothing,
// so both remain again, and the use is not decided.
extern fn make() -> {x: u8, y: u8};
extern fn f({x: u8});
extern fn f({y: u8});

let `make()`;
let `f(..)`;
`make()` = make() @ make;
`f(..)` = f(`make()`) @ f;

must fail;
assert f == undecided;
