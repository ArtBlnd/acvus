// fn adder(k) { |x| x + k }
// let cap = 1u8;
// let h = || adder(cap);
// let f = h(); f(2u8)
// adder's C ties k to its result: the closure it returns is made anew with its
// environment, which holds x and so k. So adder(cap) is one
// constraint, joined to the capture cap: the environment's, whose instance of
// all of adder's C makes the closure, and f(2u8) is u8.
extern fn core::add(&u8, &u8) -> u8;
extern fn core::add(&u16, &u16) -> u16;
group adder {
    let K;
    let `adder result`;
    fn adder(K) -> `adder result`;
}
group λ in adder {
    let X;
    let `λ result`;
    fn λ(X) -> `λ result`;
    let `&x`;
    let `&k`;
    let S;
    `&x` = &X @ `&x`;
    `λ result` = S;
}
group adder {
    let `|x| x + k`: lambda λ;
    `adder result` = `|x| x + k`;
}
group λ {
    `&k` = &K @ `&k`;
    S = core::add(`&x`, `&k`) @ `x + k`;
}
group h in run {
    let `h result`;
    fn h() -> `h result`;
    let `adder(cap)`;
    `h result` = `adder(cap)`;
}
let 1u8: u8;
let CAP;
CAP = 1u8;
let `|| ..`: lambda h;
let H;
H = `|| ..`;
let `h()`;
`h()` = (H)() @ `h call`;
let F;
F = `h()`;
let 2u8: u8;
let `f(2u8)`;
`f(2u8)` = (F)(2u8) @ `f call`;
group h {
    `adder(cap)` = adder(CAP) @ `adder call`;
}
must pass;
assert `f(2u8)`: u8;
