//@ spec: l.217, l.222, with Example 6 (l.435–449), l.86, l.280, l.299, l.301
// let mut last = None;
// let remember = |x| last = Some(x);
// remember(1u8);
// remember(2u16);
// As in Example 6, the write is a meeting L ≥ Option⟨S⟩ with S ≥ X, resting
// on X, in the lambda's C. last's type L is the enclosing binding group's
// class, not universal (l.217), so each instance shares it and copies only
// S and X (l.222): L's payload P has the lower bounds ?k, S' = u8 and
// S'' = u16. ?k falls back to !, and u8 and u16 have no common ancestor
// (l.86), so P has no value (l.280, l.301).
group λ in run {
    let X;
    let S;
    let `Some(x)`: Option<S>;
    let `λ's ()`: ();
    let `λ result`;
    fn λ(X) -> `λ result`;
    S = X;
}
let L;
let ?k;
let None: Option<?k>;
let `|x| ..`: lambda λ;
let remember;
L = None;
remember = `|x| ..`;
group λ {
    #[by_name] L = `Some(x)`;
    `λ result` = `λ's ()`;
}
let 1u8: u8;
let `remember(1u8)`;
`remember(1u8)` = (remember)(1u8) @ `remember(1u8)`;
let 2u16: u16;
let `remember(2u16)`;
`remember(2u16)` = (remember)(2u16) @ `remember(2u16)`;

must fail;
assert `remember(1u8)` == calls {λ};
assert `remember(2u16)` == calls {λ};
assert refused no_join `L.Payload(Some)`;
