//@ spec: l.282, l.292; Example 3, l.385–400, without the conversion
// let mut buf = Vec::new();
// push(&mut buf, 1u16);    // push(&mut Vec<T>, T)
// consume(buf);            // consume(Vec<u8>)
// push's T is an unknown that 1u16 meets, T ≥ u16; the two invariant arguments
// make T's value the u8 the equations give (l.275). A lower bound reaches its
// value by ≤ alone (l.282), and u16 does not reach u8 by ≤: refused at that
// lower bound (l.292). The text records the boundary ?t ⇝ u8 at consume(buf)
// in place of that equation (l.280), and refuses there.
extern type Vec<T>;
extern fn new<T>() -> Vec<T>;
extern fn push<T>(&mut Vec<T>, T);
extern fn consume(Vec<u8>);

let B;
let `new()`;
let `&mut buf`;
let 1u16: u16;
let `push(..)`;
let `consume(..)`;
`new()` = new() @ new;
B = `new()`;
`&mut buf` = &mut B @ lend;
`push(..)` = push(`&mut buf`, 1u16) @ push;
`consume(..)` = consume(B) @ consume;

must fail;
assert B: Vec<u8>;
assert push == push#0;
assert lend == lend &mut place;
assert failing [`1u16 <= push.Var(Type(0))`];
