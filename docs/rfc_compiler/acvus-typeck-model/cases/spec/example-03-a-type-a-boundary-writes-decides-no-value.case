//@ spec: Example 3, l.385–400, with the declared conversion u16 → u8
// let mut buf = Vec::new();
// push(&mut buf, 1u16);    // push(&mut Vec<T>, T)
// consume(buf);            // consume(Vec<u8>)
extern type Vec<T>;
extern fn new<T>() -> Vec<T>;
extern fn push<T>(&mut Vec<T>, T);
extern fn consume(Vec<u8>);
#[conversion] extern fn narrow(u16) -> u8;

let B;
let `new()`;
let `&mut buf`;
let 1u16: u16;
let `push(..)`;
let `consume(..)`;
`new()` = new() @ new;
B = `new()`;
`&mut buf` = &mut B @ lend;
`push(..)` = push(`&mut buf`, 1u16) @ push;
`consume(..)` = consume(B) @ consume;

// The text refuses it at consume(buf), B being Vec<u16>: a split records the
// boundary ?t ⇝ u8 toward a type the declaration writes, and u16 enters ?t
// (l.280, l.393–400). The model, which records the equation ?t = u8 there,
// gives B Vec<u8> and refuses where 1u16 enters push's T: a lower bound reaches
// by ≤ alone (l.282), and the conversion is not taken.
must fail;
assert B: Vec<u8>;
assert failing [`1u16 <= push.Var(Type(0))`];
