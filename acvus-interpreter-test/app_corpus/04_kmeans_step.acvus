// app: 04 kmeans_step
// desc: one k-means iteration over integer points: assign each point to its
// nearest centroid, sum each cluster, move each centroid to its cluster's
// mean, and report the new centroids, the cluster sizes and the inertia
// against the new centroids
// expect: centroids (2,2) (11,10) (3,13); sizes 4,5,3; inertia 26
let xs = vec([1, 2, 3, 2, 10, 11, 12, 10, 12, 2, 3, 4]);
let ys = vec([1, 2, 1, 4, 9, 10, 11, 12, 8, 13, 12, 14]);
let cx = vec([0, 8, 5]);
let cy = vec([0, 8, 15]);
let n = xs.len();
let k = cx.len();

// The nearest centroid of each point; ties go to the lower cluster.
let assign = filled(n, 0);
for p in 0u64..n {
    let best = 0;
    let best_d = i64::MAX();
    for c in 0u64..k {
        let dx = xs[p] - cx[c];
        let dy = ys[p] - cy[c];
        let d = dx * dx + dy * dy;
        if d < best_d {
            best_d = d;
            best = c as i64;
        };
    }
    assign[p] = best;
}

// Per-cluster sums and sizes, keyed by the assignment.
let sx = filled(k, 0);
let sy = filled(k, 0);
let size = filled(k, 0);
for p in 0u64..n {
    let a = assign[p] as u64;
    sx[a] = sx[a] + xs[p];
    sy[a] = sy[a] + ys[p];
    size[a] = size[a] + 1;
}

// Each centroid moves to its cluster's mean; an empty cluster stays.
for c in 0u64..k {
    if size[c] > 0 {
        cx[c] = sx[c] / size[c];
        cy[c] = sy[c] / size[c];
    };
}

let inertia = 0;
for p in 0u64..n {
    let a = assign[p] as u64;
    let dx = xs[p] - cx[a];
    let dy = ys[p] - cy[a];
    inertia = inertia + dx * dx + dy * dy;
}

let render = |cx, cy, size, inertia| -> {
    let shown = "centroids".to_string();
    for c in 0u64..cx.len() {
        shown = shown + " (" + cx[c].to_string() + "," + cy[c].to_string() + ")";
    }
    shown = shown + "; sizes ";
    for c in 0u64..size.len() {
        if c > 0u64 {
            shown = shown + ",";
        };
        shown = shown + size[c].to_string();
    }
    shown + "; inertia " + inertia.to_string()
};
render(&cx, &cy, &size, inertia)
