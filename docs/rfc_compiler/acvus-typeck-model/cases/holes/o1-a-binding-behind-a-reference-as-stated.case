//@ hole: O1
// let o = Some(1u8);
// if let Some(x) = &o { }
// Depending on what l.241 states alone, x may be decided before the projection
// on its path, reading it as passing no reference.

let S;
let `Some(1u8)`: Option<S>;
let 1u8: u8;
let O;
let `&o`;
let `Some.0`;
let X;
S = 1u8;
O = `Some(1u8)`;
`&o` = &O @ `&o`;
`Some.0` = `&o` as Some @ Some;
X = bind `Some.0` via [Some] @ x;

outcome {
    assert X: u8;
    assert istar soundness x;
}
outcome {
    assert X: &u8;
}
