-- calc_discount --
=== main ===
     0 |   r0 = ref $v1
     1 |   r1 = load r0
     2 |   r2 = ref $v2
     3 |   r3 = load r2
     4 |   r4 = r1 * r3
     6 |   r5 = r4 / 100 (r6)
     7 |   return r5

