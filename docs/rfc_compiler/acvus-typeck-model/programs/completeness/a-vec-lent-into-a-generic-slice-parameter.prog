// from cases/completeness/a-vec-lent-into-a-generic-slice-parameter.case
// let v = make();          // make() -> Vec<u8>; the view as_slice(&Vec<T>) -> &[T]
// first(&v);               // first<T>(&[T]) -> Option<&T>
// &v passes into &[T], which the declaration writes: a coercion constraint.
// not asserted here: assert outcomes 1;
row as_slice<T>: &Vec<T> -> &[T];
declare make_result = Vec<u8>;
make <- make_result;
v <- make;
ref_v: ref_v <- &v;
declare first_p0 = &[first_t];
declare first_result = Option<&first_t>;
first_0: pass ref_v to first_p0;
first <- first_result;

assert accepted;
assert v: Vec<u8>;
assert first: Option<&u8>;
