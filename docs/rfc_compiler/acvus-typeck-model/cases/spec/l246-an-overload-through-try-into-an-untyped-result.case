//@ spec: l.246, l.282, l.290
// let n = parse("7")?; take(n); Some(n)   // the script's result untyped
// The common part decides ? as before, but n passes into take's u8 and into
// the payload of the script's result, which nothing types: a class nothing
// enters is filled only once every place it passes into has a value (l.282),
// so n is not filled, parse reads nothing at its result, and the program is
// refused there (l.290). Typed, the result is accepted (the case above).
extern fn parse(&str) -> Option<u8>;
extern fn parse(&str) -> Option<u16>;
extern fn take(u8);
let Str: str;
let s: &Str;
let P;
let N;
let R;
let K;
let `Some(n)`: Option<K>;
let `take(n)`;
P = parse(s) @ parse;
N = ?(P) into R @ q;
`take(n)` = take(N) @ take;
K = N;
R = `Some(n)`;

must fail;
assert parse == undecided;
