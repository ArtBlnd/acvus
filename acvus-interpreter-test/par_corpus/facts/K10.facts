for slice(r8) -> L1 else L2 stages [L1, L6]
// L1: free {take, const, %, const, ==}
// L6: cycle Carried(r11)+Carried(r12) any_order law(Product(Carried(r11): Op(Add) exact commutative, Carried(r12): Op(Add) exact commutative) exact commutative) {+, +, jump, jump}
// control upfront
