// let mut a = Some(1u8);
// let mut b = Some(2u16);
// let r = if c { &mut a } else { &mut b };
// Neither A nor B is a reference, so each lend's target is its place.
// R's two lower bounds are &mut references, whose target is invariant, so
// R's target equals A and equals B, and A and B are unified.
// Their payloads, the same variant's, are unified in turn (congruence), or
// the one class takes Option once with both lower bounds: either
// way one payload class has the lower bounds u8 and u16, which have no
// common ancestor, so it has no value.
let A;
let S1;
let 1u8: u8;
let `Some(1u8)`: Option<S1>;
let B;
let S2;
let 2u16: u16;
let `Some(2u16)`: Option<S2>;
let `&mut a`;
let `&mut b`;
let R;
S1 = 1u8;
A = `Some(1u8)`;
S2 = 2u16;
B = `Some(2u16)`;
`&mut a` = &mut A @ `lend a`;
`&mut b` = &mut B @ `lend b`;
R = `&mut a`;
R = `&mut b`;

must fail;
assert `lend a` == lend &mut place;
assert `lend b` == lend &mut place;
assert refused no_join `A.Payload(Some)`;
