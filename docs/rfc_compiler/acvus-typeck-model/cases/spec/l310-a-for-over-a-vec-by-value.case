//@ spec: l.310, l.306, l.154
// for x in v {}   // v: Vec<u8>
// Anything that is indexed is gone over, as 준량 decided: x reads Vec's element
// by value, u8 (l.310).
extern type Vec<T>;
#[cast] extern fn core::as_slice<T>(&Vec<T>) -> &[T];
#[cast] extern fn core::as_slice_mut<T>(&mut Vec<T>) -> &mut [T];
let U8: u8;
let V: Vec<U8>;
let `v[_]`;
`v[_]` = V[] @ `v elem`;
let X;
X = bind `v[_]` via [`v elem`] @ x;

must pass;
assert X: u8;
