// let x = None;
// let y = if c { x } else { Some(1u16) };
// take(x);                 // take(Option<u8>), encoded as the boundary it records
let X;
let ?k;
let None: Option<?k>;
let Y;
let S;
let u16: u16;
let `Some(1u16)`: Option<S>;
let u8: u8;
let `Option⟨u8⟩`: Option<u8>;
X = None;
Y = X;
S = u16;
Y = `Some(1u16)`;
`Option⟨u8⟩` = X;

// Nothing enters X's payload P. Its upper bounds are Y's
// payload, which is u16, and the u8 of P ⇝ u8, which the decomposition of
// X ⇝ Option<u8> records: two types, so P is not filled and has no value.
must fail;
assert Y: Option<u16>;
assert X: none;
assert refused no_fill `X.Payload(Some)`;
