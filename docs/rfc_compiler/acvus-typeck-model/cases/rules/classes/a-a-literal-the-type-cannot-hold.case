// @n = 256;                // @n is the host's u8
// The literal's type is ?{256}, and the store is the coercion constraint
// 256 ⇝ @n, which unifies ?{256} with u8. u8 does not hold 256, so the
// unification gives no result, and the program is refused there.
let `@n`: host u8;
let 256: lit 256;
`@n` = 256;

must fail;
assert refused conflict at "256 ~> @n";
