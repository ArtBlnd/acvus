//@ spec: l.107, l.111, l.328, l.335
// f(make());               // make() -> A; f(u8) -> u8, f(u16) -> u16;
//                          // a declared conversion A → u8
// A reaches u8 only by the conversion, which is no composition and has no
// rank (l.111), and narrowing takes none (l.335); A reaches u16 by nothing.
// No candidate remains, and the use is not decided.
extern type A;
extern fn make() -> A;
extern fn f(u8) -> u8;
extern fn f(u16) -> u16;
#[conversion] extern fn conv(A) -> u8;

let `make()`;
let `f(..)`;
`make()` = make() @ make;
`f(..)` = f(`make()`) @ f;

must fail;
assert f == undecided;
