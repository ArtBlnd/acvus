// The candidates' generalization is g(?0) -> bool, ?0 standing for u8 or u16,
// which no candidate writes a reference at: before g is decided, x meets ?0
// and ?0 is no reference, which the disjunctive constraint records. bool, which every candidate
// writes at the result, is the use's constraint there alone, and
// enters the result as the text is recorded.
//@ order:
extern fn g(u8) -> bool;
extern fn g(u16) -> bool;

let x: u8;
let R;
R = g(x) @ g;

assert record records `g.GeneralizedResult <= R`;
assert disjunction records `g.Generalized(0): no reference`;
assert disjunction records `x <= g.Generalized(0)`;
must pass;
assert R: bool;
