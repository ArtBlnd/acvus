     7 |   r6 = r2 + r5
     9 |   r7 = r6 + T1
    10 |   r8 = ref $v3
    11 |   r9 = load r8
    12 |   r10 = call #0(r9)
    13 |   r11 = r7 + r10
    15 |   r12 = r11 + T2
