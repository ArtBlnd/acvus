//@ spec: l.317, l.330
// let x = 1u8;
// f(x)                     // no declaration named f
// f's candidates are the declarations its name reaches (l.317), none, so no
// candidate remains and f is not decided (l.330, l.287).
let X;
let 1u8: u8;
let R;
X = 1u8;
R = f(X) @ f;

must fail;
assert f == undecided;
