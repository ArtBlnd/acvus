//@ hole: T2
//@ spec: review 2's P4
// fn g(a, b) { g(b, b); 0u8 }
// g(Some(f1()), Some(f2()))    // f1() -> F1, f2() -> F2; casts F1 → G, F2 → G
// The copied boundary B' ⇝ A' relates the payloads once both are solved, so A''s
// payload has F1 and F2 entering it in every order, each by a part lower bound
// (l.280). A part takes no cast (l.74), so the two have no join (l.89), and
// the program is refused there in every order.
extern type F1;
extern type F2;
extern type G;
extern fn f1() -> F1;
extern fn f2() -> F2;
#[cast] extern fn up1(F1) -> G;
#[cast] extern fn up2(F2) -> G;

group g {
    let A;
    let B;
    let R;
    let `g(b, b)`;
    let 0u8: u8;
    fn g(A, B) -> R;
    `g(b, b)` = g(B, B) @ `g(b, b)`;
    R = 0u8;
}
let `f1()`;
let `f2()`;
let S1;
let S2;
let `Some(f1())`: Option<S1>;
let `Some(f2())`: Option<S2>;
let `g(..)`;
`f1()` = f1() @ f1;
`f2()` = f2() @ f2;
S1 = `f1()`;
S2 = `f2()`;
`g(..)` = g(`Some(f1())`, `Some(f2())`) @ `g(..)`;

must fail;
assert `g(..)`: u8;
assert refused no_join `g@6/A.Payload(Some)`;
