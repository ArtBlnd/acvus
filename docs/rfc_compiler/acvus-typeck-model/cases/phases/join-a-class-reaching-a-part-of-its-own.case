//@ spec: l.275
// X ≥ Some(x), whose payload S ≥ X: X reaches a part of its own along lower
// bounds and parts, and no finite type holds it.
//@ order: solve X
let X;
let ?k;
let None: Option<?k>;
let S;
let `Some(x)`: Option<S>;
X = None;
S = X;
X = `Some(x)`;

assert trace "join X: infinite";
assert trace "refuse: infinite X";
must fail;
assert refused infinite X;
