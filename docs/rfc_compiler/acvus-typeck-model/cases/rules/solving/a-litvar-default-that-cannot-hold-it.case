// let x = 3000000000;
// X is unified with the literal's LitVar, its only lower bound, and no
// source gives it a constructor. At the fixpoint, nothing waits, so it takes
// its family's default, i32, which does not hold 3000000000:
// refused there.
let X;
let 3000000000: lit 3000000000;
X = 3000000000;

must fail;
assert refused conflict at "the default of 3000000000";
