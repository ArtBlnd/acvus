//@ spec: l.308
// let p = mk();            // mk() -> {x: u8}
// let {x: a} = p;
// take(a);                 // take(&u8)
// No class on a's path is a reference, so the binding reads its position
// (l.308): a is u8, and u8 reaches &u8 by no coercion (l.282).
extern fn mk() -> {x: u8};
extern fn take(&u8);

let P;
let `mk()`;
let `.x`;
let A;
let `take(a)`;
`mk()` = mk() @ mk;
P = `mk()`;
`.x` = P.x @ `.x`;
A = bind `.x` via [`.x`] @ a;
`take(a)` = take(A) @ take;

must fail;
assert a == read;
assert failing [`A ~> take.Param(0)`];
