for slice(r16) -> L1 else L2 stages [L1, L3, L4]
// L1: cycle Storage(r17) in_order law(Op(Concat) exact) scan {ref, concat, assign}
// L3: free {ref, as_slice, call to_string}
// L4: cycle Storage(r18) in_order law(Fold(r18, #2) exact) {ref, call push}
// control upfront
// cost W=7 O=18287 split when n > 83598, n = len(r16)
