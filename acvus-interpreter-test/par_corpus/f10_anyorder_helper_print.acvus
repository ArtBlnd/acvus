// id: F10
// family: iterators
// desc: a local `each(v, f)` helper with a loop, called under anyorder with a printing lambda
// expect: 5\n3\n2
let each = |v, f| -> {
    for x in &v {
        f(*x);
    }
    v.len()
};
let n = 0u64;
anyorder {
    n = each(vec([5, 3]), |x| -> io::print(&x.to_string()));
}
n
