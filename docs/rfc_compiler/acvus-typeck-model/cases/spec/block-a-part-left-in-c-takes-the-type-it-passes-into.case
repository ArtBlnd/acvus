// let x: Vec<u8> = { Vec::new() };
// new's T is left in the lambda's C, and the call's instance copies it.
// The call's result passes into the Vec<u8> the text writes, a
// coercion constraint whose decomposition records a coercion constraint toward u8, and the copy of
// T, which nothing enters, is filled with u8.
extern type Vec<T>;
extern fn new<T>() -> Vec<T>;
group λ in run {
    let `λ result`;
    let `new()`;
    fn λ() -> `λ result`;
    `λ result` = `new()`;
}
let E: u8;
let X: Vec<E>;
let `{..}`: lambda λ;
let `{..}()`;
`{..}()` = (`{..}`)() @ call;
X = `{..}()`;
group λ {
    `new()` = new() @ new;
}

must pass;
assert X: Vec<u8>;
