//@ spec: l.156, l.276, l.278, l.290
// let a;
// a[0] = 1;
// The kind "indexes τ" names no member, so A has no source that gives a
// constructor and falls back to !, whose element is ! (l.278): the literal
// entering it has no type there.
let A;
let `a[0]`;
let 1: lit 1;
`a[0]` = A[] @ `a[0]`;
`a[0]` = 1;

must fail;
