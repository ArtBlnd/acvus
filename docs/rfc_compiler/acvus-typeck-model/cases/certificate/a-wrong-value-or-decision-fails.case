// let x = make();          // make() -> A
// probe(x);                // probe(A), probe(B)
// Accepted as probe(A), with x: A. Given x: B, the pass of make() into X and
// probe(A)'s boundary fail; decided as probe(B), its boundary fails; given
// probe(x): &A, its result fails, the one its generalization records at once and
// the candidate's alike.
extern type A;
extern type B;
extern fn make() -> A;
extern fn probe(A);
extern fn probe(B);

let X;
let `make()`;
let `probe(x)`;
`make()` = make() @ make;
X = `make()`;
`probe(x)` = probe(X) @ probe;

must pass;
assert probe == probe#0;
assert certificate set X: B fails ["A <= B fails", "argument 0: B into A fails"];
assert certificate set probe == probe#1 fails ["argument 0: A into B fails"];
assert certificate set `probe(x)`: &A fails ["() <= &A fails"];
