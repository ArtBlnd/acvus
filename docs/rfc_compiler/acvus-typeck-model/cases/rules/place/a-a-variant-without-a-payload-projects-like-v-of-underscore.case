//@ spec: l.307, l.304
// match 1u8 { None => {} }
// None is None(_) (l.307), the projection Payload at the scrutinee (l.304),
// whose kind u8 has no variant None (l.158).
let 1u8: u8;
let `None.0`;
`None.0` = 1u8 as None @ None;

must fail;
assert None == applied;
assert refused conflict at "1u8: variant None: None.0";
