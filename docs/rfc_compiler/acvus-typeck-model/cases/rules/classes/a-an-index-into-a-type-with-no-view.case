// let o = Some(1u8);
// let x = o[0];
// The projection o[0] reads whether O is a reference; O's only source, its
// lower bound Some(1u8), is an Option, so it applies to O,
// whose kind is then the conjunction of Option and "indexes τ". An
// Option is structural, not an extern-defined container, so it has no view,
// and a type with no view cannot have that kind: O is
// refused there.
let O;
let S;
let 1u8: u8;
let `Some(1u8)`: Option<S>;
let `o[0]`;
let X;
S = 1u8;
O = `Some(1u8)`;
`o[0]` = O[] @ `o[0]`;
X = `o[0]`;

must fail;
assert `o[0]` == applied;
assert refused conflict at "the value of O";
