// a + b                    // add(&B, &B) -> B, add(&u8, &u8) -> u8; a = make_a(), b = make_b()
// // a cast A -> B
// The two operands are one variable in every candidate, so &a and &b enter
// it, and the targets of the two references are one class, a reference's
// target being invariant: a and b are that class. Its lower bounds are
// make_a()'s A and make_b()'s B, which have no join: the cast A -> B decides
// nothing. The program is refused there, no_join.
extern type A;
extern type B;
#[cast] extern fn up(A) -> B;
#[cast] extern fn up_ref(&A) -> &B;
extern fn make_a() -> A;
extern fn make_b() -> B;
extern fn core::add(&B, &B) -> B;
extern fn core::add(&u8, &u8) -> u8;
let X;
let Y;
let `make_a()`;
let `make_b()`;
let `&a`;
let `&b`;
let R;
`make_a()` = make_a() @ make_a;
X = `make_a()`;
`make_b()` = make_b() @ make_b;
Y = `make_b()`;
`&a` = &X @ `&a`;
`&b` = &Y @ `&b`;
R = core::add(`&a`, `&b`) @ `a + b`;

must fail;
assert refused no_join X;
