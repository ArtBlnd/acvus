-- compute_score --
=== main ===
     0 |   r0 = ref $v1
     1 |   r1 = load r0
     2 |   r2 = ref $v2
     3 |   r3 = load r2
     4 |   r4 = r1 + r3
     5 |   r5 = ref $v3
     6 |   r6 = load r5
     7 |   r7 = r4 * r6
     9 |   r8 = r7 / 100 (r9)
    10 |   return r8

