//@ spec: the example of l.247–258
// let mut a;
// a.x = 0;
// a = pick(a);             // pick({x: i32}) -> {x: i32}, pick(u8) -> u8
extern fn pick({x: i32}) -> {x: i32};
extern fn pick(u8) -> u8;

let A;
let `a.x`;
let 0: lit 0;
let `pick(a)`;
`a.x` = A.x @ `a.x`;
`a.x` = 0;
`pick(a)` = pick(A) @ pick;
A = `pick(a)`;

must pass;
assert pick == pick#0;
assert `a.x` == applied;
assert A: {x: i32};
