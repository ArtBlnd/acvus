//@ spec: Example 7, l.450–465, the write in a lambda
// let mut x = None;
// let r = &mut x;
// let f = || *r = Some(1u8);
// f();
// The write through the captured r is a boundary (l.464), whose payload, an
// unknown of the enclosing group, takes a lower bound (l.286).
group λ in run {
    let `*r`;
    let S;
    let `Some(1u8)`: Option<S>;
    let 1u8: u8;
    let `()`: ();
    let `λ result`;
    fn λ() -> `λ result`;
    S = 1u8;
    `λ result` = `()`;
}
let X;
let ?k;
let None: Option<?k>;
let `&mut x`;
let R;
let `|| ..`: lambda λ;
let f;
let `f()`;
X = None;
`&mut x` = &mut X @ `&mut x`;
R = `&mut x`;
f = `|| ..`;
`f()` = (f)() @ `f()`;
group λ {
    `*r` = *R @ `*r`;
    #[through_ref] `*r` = `Some(1u8)`;
}

must pass;
assert X: Option<u8>;
