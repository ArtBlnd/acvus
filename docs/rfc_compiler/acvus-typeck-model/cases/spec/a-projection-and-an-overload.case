// let mut a;
// a.x = 0;
// a = pick(a);             // pick({x: i32}) -> {x: i32}, pick(u8) -> u8
// A's only lower bound is pick's result, which is one of two constructors
// until a candidate remains; the candidate is read off A, which waits for
// that result. The projection a.x makes no type. Nothing gives A a value, so
// the program is refused.
extern fn pick({x: i32}) -> {x: i32};
extern fn pick(u8) -> u8;

let A;
let `a.x`;
let 0: lit 0;
let `pick(a)`;
`a.x` = A.x @ `a.x`;
`a.x` = 0;
`pick(a)` = pick(A) @ pick;
A = `pick(a)`;

must fail;
