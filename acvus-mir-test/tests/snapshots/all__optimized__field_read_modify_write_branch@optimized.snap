=== main ===
     0 |   r0 = fetch @stats
     1 |   assign @stats = r0
     2 |   r1 = take @stats.count
     4 |   r2 = r1 + 1 (r3)
     5 |   r4 = take @stats.threshold
     6 |   r5 = r2 > r4
     7 |   r6 = test r5 == true
     8 |   if r6 -> L0 else L1 join L1
     9 | L0:
    10 |   assign @stats.count = r2
    12 |   assign @stats.exceeded = true (r7)
    13 |   jump L1
    14 | L1:
    15 |   r8 = take @stats.count
    16 |   r9 = take @stats
    17 |   commit @stats = r9
    18 |   return r8

