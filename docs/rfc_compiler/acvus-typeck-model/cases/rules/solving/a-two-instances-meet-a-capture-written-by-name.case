//@ spec: l.188, l.198, l.221, l.229, l.276, l.292
// let mut last = None;
// let remember = |x| last = Some(x);
// remember(1u8);
// remember(2u16);
// last is reached by name and its type L is an unknown of the enclosing binding
// group, so the write in the lambda is a meeting, L ≥ Some(x) (l.221, l.229).
// It names L, and x's type X is joined to it through S, so they are the
// lambda's environment, recorded once in the enclosing group (l.188): X is one
// unknown of that group, which both calls' arguments meet (l.198), X ≥ u8 and
// X ≥ u16, which have no join (l.276): refused at X (l.292).
group λ in run {
    let X;
    let S;
    let `Some(x)`: Option<S>;
    let `()`: ();
    let `λ result`;
    fn λ(X) -> `λ result`;
    S = X;
}
let L;
let ?k;
let None: Option<?k>;
let `|x| ..`: lambda λ;
let remember;
L = None;
remember = `|x| ..`;
let 1u8: u8;
let `remember(1u8)`;
`remember(1u8)` = (remember)(1u8) @ `remember(1u8)`;
let 2u16: u16;
let `remember(2u16)`;
`remember(2u16)` = (remember)(2u16) @ `remember(2u16)`;
group λ {
    #[by_name] L = `Some(x)`;
    `λ result` = `()`;
}

must fail;
assert `remember(1u8)` == calls {λ};
assert `remember(2u16)` == calls {λ};
assert refused no_join X;
