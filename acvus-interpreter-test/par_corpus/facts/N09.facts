for range(0 (r2)..5 (r3)) -> L1 else L2 stages [L1, L7]
// L1: free {const}
// L7: cycle Carried(r1) any_order law(Op(Add) exact commutative) {+, jump, jump}
// control upfront
// cost in place: W=0
for range(0 (r6)..r4) -> L4 else L5 stages [L4, L6]
// L4: free {*}
// L6: cycle Carried(r5) any_order law(Op(Add) exact commutative) {+}
// control upfront
// cost W=1 O=18281 split when n > 584992, n = max(r4 - 0 (r6), 0)
