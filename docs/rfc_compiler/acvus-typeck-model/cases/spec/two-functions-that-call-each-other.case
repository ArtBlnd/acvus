//@ orders: sampled 200
// fn even(n) { if n == 0 { true } else { odd(n - 1) } }
// fn odd(n)  { if n == 0 { false } else { even(n - 1) } }
// even(10u8)
// In even(10u8)'s instance odd's n has no source but the boundary of
// even's recursive call. Once a common part's split equates it with the
// literals, n == 0 and n - 1 in odd depend on each other and break their
// dependencies. n - 1 is decided by its result, u8, and
// what it records goes into its parameters' types, which n == 0 does not
// read, so it is recorded at once: n is unified with u8, and n == 0
// reads it. Accepted in every order, where whether n - 1 was decided before
// that split, accepted, or after it, refused, had been the order's.
extern fn core::eq(&u8, &u8) -> bool;
extern fn core::eq(&u16, &u16) -> bool;
extern fn core::sub(&u8, &u8) -> u8;
extern fn core::sub(&u16, &u16) -> u16;
group eo {
    let NE;
    let RE;
    let NO;
    let RO;
    fn even(NE) -> RE;
    fn odd(NO) -> RO;
    let `&n e`;
    let ?ze: lit 0;
    let `&0 e`;
    let EQE;
    let CE: bool;
    `&n e` = &NE @ `&n e`;
    `&0 e` = &?ze @ `&0 e`;
    EQE = core::eq(`&n e`, `&0 e`) @ `n == 0 e`;
    CE = EQE;
    let `&n e 2`;
    let ?oe: lit 1;
    let `&1 e`;
    let SE;
    `&n e 2` = &NE @ `&n e 2`;
    `&1 e` = &?oe @ `&1 e`;
    SE = core::sub(`&n e 2`, `&1 e`) @ `n - 1 e`;
    let `odd(n - 1)`;
    `odd(n - 1)` = odd(SE) @ `odd(n - 1)`;
    let TE: bool;
    RE = TE;
    RE = `odd(n - 1)`;
    let `&n o`;
    let ?zo: lit 0;
    let `&0 o`;
    let EQO;
    let CO: bool;
    `&n o` = &NO @ `&n o`;
    `&0 o` = &?zo @ `&0 o`;
    EQO = core::eq(`&n o`, `&0 o`) @ `n == 0 o`;
    CO = EQO;
    let `&n o 2`;
    let ?oo: lit 1;
    let `&1 o`;
    let SO;
    `&n o 2` = &NO @ `&n o 2`;
    `&1 o` = &?oo @ `&1 o`;
    SO = core::sub(`&n o 2`, `&1 o`) @ `n - 1 o`;
    let `even(n - 1)`;
    `even(n - 1)` = even(SO) @ `even(n - 1)`;
    let FO: bool;
    RO = FO;
    RO = `even(n - 1)`;
}
let 10u8: u8;
let `even(10u8)`;
`even(10u8)` = even(10u8) @ `even(10u8)`;

must pass;
assert `even@20/n - 1 o` == core::sub#0;
assert `even@20/n == 0 o` == core::eq#0;
assert `even@20/n - 1 e` == core::sub#0;
assert `even@20/n == 0 e` == core::eq#0;
assert `even(10u8)`: bool;
