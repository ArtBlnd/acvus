for slice(r15) -> L1 else L2 stages [L1, L3, L4]
// L1: cycle Storage(r16) in_order {ref, call pop, call unwrap, ref, call push}
// L3: free {take, +}
// L4: cycle Storage(r17) in_order law(Fold(r17, #3) exact) {ref, call push}
// control upfront
// cost W=4 O=18287 split when n > 146296, n = len(r15)
