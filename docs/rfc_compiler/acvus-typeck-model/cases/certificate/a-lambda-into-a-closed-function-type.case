// apply(|x| x, 1u8);       // apply(fn(u8) -> u8, u8) -> u8, apply(fn(u8) -> u8, u16) -> u16
// Both candidates write fn(u8) -> u8 first, so the generalization records it whole,
// and its decomposition makes λ's instance there; the checker finds it
// at the class the generalization made.
extern fn apply(fn(u8) -> u8, u8) -> u8;
extern fn apply(fn(u8) -> u8, u16) -> u16;
group λ in run {
    let X;
    let `λ result`;
    fn λ(X) -> `λ result`;
    `λ result` = X;
}
let `|x| x`: lambda λ;
let 1u8: u8;
let R;
R = apply(`|x| x`, 1u8) @ apply;

must pass;
assert apply == apply#0;
assert R: u8;
