-- compute_score --
=== main ===
     0 |   r0 = take $v1
     1 |   r1 = take $v2
     2 |   r2 = r0 + r1
     3 |   r3 = take $v3
     4 |   r4 = r2 * r3
     6 |   r5 = r4 / 100 (r6)
     7 |   return r5

    ; r0 ($profile) : Int
    ; r1 ($history) : Int
    ; r2 (v6) : Int
    ; r3 ($weight) : Int
    ; r4 (v8) : Int
    ; r5 (v10) : Int
    ; r6 (v9) : Int
    ; r7 (v3) : Int
    ; r8 (v2) : Int
    ; r9 (v1) : Int

-- format_label --
=== literals ===
  T0 = "User("
  T1 = " score:"
  T2 = ")"

=== main ===
     1 |   r0 = take $v1
     2 |   r1 = call #0(r0)
     3 |   r2 = T0 + r1
     5 |   r3 = r2 + T1
     6 |   r4 = take $v2
     7 |   r5 = call #0(r4)
     8 |   r6 = r3 + r5
    10 |   r7 = r6 + T2
    11 |   return r7

    ; r0 ($profile) : Int
    ; r1 (to_string(...)) : String
    ; r2 (v6) : String
    ; r3 (v8) : String
    ; r4 ($score) : Int
