//@ spec: l.317, l.219, l.227
// pair(1u8, 2u16)          // pair<T>(T, T)
// pair's T is an unknown of the entry made at this use (l.317), so both
// arguments meet it (l.219): two lower bounds, u8 and u16, with no join.
extern fn pair<T>(T, T);

let 1u8: u8;
let 2u16: u16;
let `pair(..)`;
`pair(..)` = pair(1u8, 2u16) @ pair;

must fail;
assert refused no_join `pair.Var(Type(0))`;
