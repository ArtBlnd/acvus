// from cases/completeness/an-array-lent-into-a-generic-slice-parameter.case
// let a = [1u8, 2u8];
// let f = first(&a);       // first<T>(&[T]) -> Option<&T>; the array's view &[T; 2] -> &[T]
// &a passes into &[T], which the declaration writes: a coercion constraint.
// not asserted here: assert outcomes 1;
array_one_u8_two_u8 <- [u8_; 2];
one_u8 <- u8;
two_u8 <- u8;
u8_ <- one_u8;
u8_ <- two_u8;
a <- array_one_u8_two_u8;
ref_a: ref_a <- &a;
declare first_p0 = &[first_t];
declare first_result = Option<&first_t>;
first_0: pass ref_a to first_p0;
first_call <- first_result;
f <- first_call;

assert accepted;
assert f: Option<&u8>;
