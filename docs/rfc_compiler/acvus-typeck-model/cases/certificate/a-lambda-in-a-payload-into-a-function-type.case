// run(Some(|x| x));        // run(Option<fn(u8) -> u8>)
// The coercion constraint's decomposition relates Some's payload to the function type there, and
// makes λ's instance. The checker carries λ to that part and
// finds the instance at those classes, where it panicked meeting a function
// type below the top of a value. Given that instance's x: u16, the type's u8
// does not reach it, and in the instance x does not reach λ's result, u8.
extern fn run(Option<fn(u8) -> u8>);
group λ in run {
    let X;
    let `λ result`;
    fn λ(X) -> `λ result`;
    `λ result` = X;
}
let `|x| x`: lambda λ;
let S;
let `Some(|x| x)`: Option<S>;
S = `|x| x`;
let `run(..)`;
`run(..)` = run(`Some(|x| x)`) @ run;

must pass;
assert certificate set `S ~> run.Param(0).Payload(Some)#λ/X`: u16 fails ["argument 0: u8 into u16 fails", "u16 <= u8 fails"];
