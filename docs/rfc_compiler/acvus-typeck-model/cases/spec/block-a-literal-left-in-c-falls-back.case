//@ spec: l.341, l.186, l.215, l.288
// let x = { 1 };
// The block is (|| 1)() (l.341). Its expression names no capture, so it is
// the lambda's generic part (l.186): the result type holds the LitVar alone,
// which nothing decides in the lambda's binding group, where nothing falls
// back (l.286), so it is left in C. The call's instance copies it into the
// run's binding group (l.215), where the copy falls back to i32 (l.288).
group λ in run {
    let `λ result`;
    let ?one: lit 1;
    fn λ() -> `λ result`;
    `λ result` = ?one;
}
let X;
let `{..}`: lambda λ;
let `{..}()`;
`{..}()` = (`{..}`)() @ call;
X = `{..}()`;

must pass;
assert X: i32;
assert call == calls {λ};
