//@ spec: l.246
// The candidates' common part is g(?0) -> bool, ?0 standing for u8 or u16,
// which no candidate writes a reference at: before g is decided, x meets ?0,
// ?0 is no reference, and bool enters the result.
//@ order:
extern fn g(u8) -> bool;
extern fn g(u16) -> bool;

let x: u8;
let R;
R = g(x) @ g;

assert node records `g.CommonResult <= R`;
assert node records `g.Common(0): no reference`;
assert node records `x <= g.Common(0)`;
must pass;
assert R: bool;
