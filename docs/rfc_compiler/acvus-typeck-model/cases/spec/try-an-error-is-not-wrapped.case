//@ orders: sampled 200
// fn g() { let x = get()?; Ok(x) }    // get() -> Result<u8, A>
// fn f() { let a = g()?; let b = get2()?; Ok(a) }    // get2() -> Result<u16, B>
// g's result is Result<u8, Error{A(A)}>, an Error only ? makes.
// In f, g()'s error value is an Error, so it is not wrapped and passes into
// the exit's error part as it is; B is wrapped into Error{B(..)}.
// The variants unite with no nesting.
extern type A;
extern type B;
extern fn get() -> Result<u8, A>;
extern fn get2() -> Result<u16, B>;
group g {
    let `g result`;
    fn g() -> `g result`;
    let `get()`;
    let X;
    let `g exit`;
    let U;
    let Q;
    let `Ok(x)`: Result<U, Q>;
    `get()` = get() @ get;
    X = ?(`get()`) into `g exit` @ qg;
    `g result` = `g exit`;
    U = X;
    `g result` = `Ok(x)`;
}
group f {
    let `f result`;
    fn f() -> `f result`;
    let `get1()`;
    let A;
    let `exit 1`;
    let `get2()`;
    let B;
    let `exit 2`;
    let S;
    let P;
    let `Ok(a)`: Result<S, P>;
    `get1()` = g() @ `g()`;
    A = ?(`get1()`) into `exit 1` @ q1;
    `f result` = `exit 1`;
    `get2()` = get2() @ get2;
    B = ?(`get2()`) into `exit 2` @ q2;
    `f result` = `exit 2`;
    S = A;
    `f result` = `Ok(a)`;
}
let `f()`;
`f()` = f() @ `f()`;

must pass;
assert `f()`: Result<u8, Error{A(A), B(B)}>;
