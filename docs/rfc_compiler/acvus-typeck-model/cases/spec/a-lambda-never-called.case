//@ spec: l.188, l.282
// let x = "s";
// let f = || takes_u8(x);  // takes_u8(u8), f never called
// takes_u8 and its boundary are the lambda's environment, the enclosing
// group's, recorded whether or not a call reaches the lambda (l.188), and
// &str ⇝ u8 fails (l.282).
extern fn takes_u8(u8);

group λ in run {
    let `λ result`;
    let `takes_u8(x)`;
    fn λ() -> `λ result`;
    `λ result` = `takes_u8(x)`;
}
let str: str;
let `"s"`: &str;
let X;
let `|| ..`: lambda λ;
let f;
X = `"s"`;
f = `|| ..`;
group λ {
    `takes_u8(x)` = takes_u8(X) @ takes_u8;
}

must fail;
assert failing [`X ~> takes_u8.Param(0)`];
