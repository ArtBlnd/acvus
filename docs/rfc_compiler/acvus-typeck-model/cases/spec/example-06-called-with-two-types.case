//@ spec: Example 6, l.427–441, called with two types; l.186, l.196, l.210, l.219, l.86, l.274, l.290
// let mut last = None;
// let remember = |x| last = Some(x);
// remember(1u8); remember(2u16);
// last is reached by name and its type L is an unknown of the enclosing binding
// group, so the write is a meeting, L ≥ Some(x) (l.219). It names the capture L,
// and x's type X is joined to it through S, so the write, S and X are the
// lambda's environment, recorded once in the enclosing binding group (l.186):
// X is no universal (l.210) but one unknown of that group, which both calls'
// arguments meet (l.196), X ≥ u8 and X ≥ u16, which have no common ancestor
// (l.86), so X has no value (l.274): refused at X (l.290).
group λ in run {
    let X;
    let S;
    let `Some(x)`: Option<S>;
    let `()`: ();
    let `λ result`;
    fn λ(X) -> `λ result`;
    S = X;
}
let L;
let ?k;
let None: Option<?k>;
let `|x| ..`: lambda λ;
let remember;
L = None;
remember = `|x| ..`;
let 1u8: u8;
let `remember(1u8)`;
`remember(1u8)` = (remember)(1u8) @ `remember(1u8)`;
let 2u16: u16;
let `remember(2u16)`;
`remember(2u16)` = (remember)(2u16) @ `remember(2u16)`;
group λ {
    #[by_name] L = `Some(x)`;
    `λ result` = `()`;
}

must fail;
assert `remember(1u8)` == calls {λ};
assert `remember(2u16)` == calls {λ};
assert refused no_join X;
