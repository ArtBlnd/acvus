//@ spec: l.310, l.306, l.154
// for x in &v {}   // v: Vec<u8>
// x is the binding at (&v)[_], which applies through & and reaches Vec's
// element along its view (l.154), so x lends it: &u8 (l.306, l.310).
extern type Vec<T>;
#[cast] extern fn core::as_slice<T>(&Vec<T>) -> &[T];
#[cast] extern fn core::as_slice_mut<T>(&mut Vec<T>) -> &mut [T];
let U8: u8;
let V: Vec<U8>;
let `&v`;
`&v` = &V @ `&v`;
let `v[_]`;
`v[_]` = `&v`[] @ `v elem`;
let X;
X = bind `v[_]` via [`v elem`] @ x;

must pass;
assert X: &u8;
