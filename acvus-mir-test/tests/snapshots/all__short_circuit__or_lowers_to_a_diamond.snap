=== main ===
     0 |   r0 = fetch @a
     1 |   r1 = fetch @b
     2 |   if r0 -> L1 else L2(r1) join L2
     3 | L1:
     5 |   jump L2(true (r2))
     6 | L2(r3: Bool):
     7 |   commit @a = r0 (not written)
     8 |   commit @b = r1 (not written)
     9 |   return r3

    ; r0 (@a) : Bool
    ; r1 (@b) : Bool
    ; r2 (v8) : Bool
