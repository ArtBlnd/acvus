    18 |   r15 = call #0(r14)
    19 |   r16 = r12 + r15
    21 |   r17 = r16 + T3
    22 |   r18 = ref $v5
    23 |   r19 = load r18
    24 |   r20 = call #0(r19)
    25 |   r21 = r17 + r20
    27 |   r22 = r21 + T4
    28 |   r23 = ref $v6
    29 |   r24 = load r23
    30 |   r25 = call #0(r24)
    31 |   r26 = r22 + r25
