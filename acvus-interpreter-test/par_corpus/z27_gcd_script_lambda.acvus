// id: Z27
// family: negative
// desc: gcd through a script lambda: gcd is associative and commutative, but no law is stated on a script function
// expect: 6
let gcd = |a, b| -> {
    let x = a;
    let y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    x
};
let xs = vec([12, 18, 24, 30]);
let g = 0;
for x in &xs {
    g = gcd(g, *x);
}
g
