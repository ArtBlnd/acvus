// let mut x = 0; while c { x = x + 1; } takes_u8(x);
// takes_u8 is decided at once. x + 1 reads X without its own relations, so
// R gives nothing and only LitVars enter X there, which takes_u8's boundary
// unifies with u8: x + 1 is add(u8), and x is u8.
extern fn core::add(&u8, &u8) -> u8;
extern fn core::add(&u16, &u16) -> u16;
extern fn core::add(&i32, &i32) -> i32;
extern fn takes_u8(u8);
let X;
let ?a: lit 0;
let ?b: lit 1;
let `&x`;
let `&1`;
let R;
let `takes_u8(x)`;
X = ?a;
`&x` = &X @ `&x`;
`&1` = &?b @ `&1`;
R = core::add(`&x`, `&1`) @ `x + 1`;
X = R;
`takes_u8(x)` = takes_u8(X) @ takes_u8;

must pass;
assert X: u8;
assert `x + 1` == core::add#0;
