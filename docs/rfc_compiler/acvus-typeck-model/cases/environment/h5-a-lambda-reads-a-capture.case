//@ hole: H5
// let x = make();          // make() -> A
// let f = || probe(x);     // probe(A), probe(B)
// f();
// Read by the captured environment (design/17-environment.md), probe is the
// enclosing group's, and reads X as A.
//@ reading: captures = environment
extern type A;
extern type B;
extern fn make() -> A;
extern fn probe(A);
extern fn probe(B);

group λ in run {
    let `λ result`;
    let `probe(x)`;
    fn λ() -> `λ result`;
    `λ result` = `probe(x)`;
}
let X;
let `make()`;
let `|| ..`: lambda λ;
let f;
let `f()`;
`make()` = make() @ make;
X = `make()`;
f = `|| ..`;
`f()` = (f)() @ `f()`;
group λ {
    `probe(x)` = probe(X) @ probe;
}

must pass;
assert probe == probe#0;
