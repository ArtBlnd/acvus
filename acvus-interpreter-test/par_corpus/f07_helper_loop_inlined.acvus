// id: F07
// family: iterators
// desc: a local `count_if(v, p)` helper whose loop the inliner exposes, called with a lambda
// expect: 2
let count_if = |v, p| -> {
    let c = 0;
    for x in &v {
        if p(*x) {
            c = c + 1;
        };
    }
    c
};
count_if(vec([5, 3, 8, 1]), |x| -> x > 4)
