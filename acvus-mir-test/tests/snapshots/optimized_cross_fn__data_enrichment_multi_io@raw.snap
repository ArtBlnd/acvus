-- main --
=== main ===
     0 |   assign $order = r0
     1 |   r1 = fetch @result_label
     2 |   assign @result_label = r1
     3 |   r2 = fetch @weight
     4 |   assign @weight = r2
     5 |   r3 = fetch @alert_count
     6 |   assign @alert_count = r3
     7 |   r4 = fetch @result_score
     8 |   assign @result_score = r4
     9 |   r5 = fetch @threshold
    10 |   assign @threshold = r5
    11 |   r6 = fetch @user_id
    12 |   assign @user_id = r6
    13 |   r7 = take @user_id
    14 |   r8 = take $order
    15 |   r9 = call #0(r7) [r8 -> r10]
    16 |   assign $order = r10
    17 |   assign profile = r9
    18 |   r11 = take @user_id
    19 |   r12 = take $order
    20 |   r13 = call #1(r11) [r12 -> r14]
    21 |   assign $order = r14
    22 |   assign history = r13
    23 |   r15 = take profile
    24 |   r16 = take history
    25 |   r17 = take @weight
    26 |   r18 = call #2(r15, r16, r17)
    27 |   assign score = r18
    28 |   r19 = take profile
    29 |   r20 = take score
    30 |   r21 = call #3(r19, r20)
    31 |   assign label = r21
    32 |   r22 = take score
    33 |   r23 = take @threshold
    34 |   r24 = r22 > r23
    35 |   assign $source = r24
    36 |   r25 = take $source
    37 |   r26 = test r25 == true
    38 |   jump_if r26 then L0 else L1
    39 | L0:
    40 |   r27 = take @user_id
    41 |   r28 = take score
    42 |   r29 = take $order
    43 |   r30 = call #4(r27, r28) [r29 -> r31]
    44 |   assign $order = r31
    45 |   r32 = take @alert_count
    47 |   r33 = r32 + 1 (r34)
    48 |   assign @alert_count = r33
    49 |   jump L1
    50 | L1:
    51 |   r35 = take label
    52 |   assign @result_label = r35
    53 |   r36 = take score
    54 |   assign @result_score = r36
    55 |   r37 = take score
    56 |   r38 = take @result_label
    57 |   commit @result_label = r38
    58 |   r39 = take @weight
    59 |   commit @weight = r39
    60 |   r40 = take @alert_count
    61 |   commit @alert_count = r40
    62 |   r41 = take @result_score
    63 |   commit @result_score = r41
    64 |   r42 = take @threshold
    65 |   commit @threshold = r42
    66 |   r43 = take @user_id
    67 |   commit @user_id = r43
    68 |   r44 = take $order
    69 |   return r37 [r44]

