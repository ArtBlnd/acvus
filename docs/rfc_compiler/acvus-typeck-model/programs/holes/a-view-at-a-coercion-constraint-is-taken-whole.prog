// from cases/holes/a-view-at-a-coercion-constraint-is-taken-whole.case
// let v = make();          // make() -> Vec<u8>; the view as_slice(&Vec<T>) -> &[T]
// take(&v);                // take(&[u8])
// The coercion constraint &V ~> &[u8] relates two references, whose constructors are
// their mutabilities alone; its decomposition records V ~> [u8] toward a type the
// declaration writes, which decides no value. V is Vec<u8>, and the
// whole value &Vec<u8> reaches &[u8] by the view's cast.
row as_slice<T>: &Vec<T> -> &[T];
declare make_result = Vec<u8>;
make <- make_result;
v <- make;
lend: ref_v <- &v;
declare take_p0 = &[u8];
declare take_result = ();
take_0: pass ref_v to take_p0;
take <- take_result;

assert accepted;
assert v: Vec<u8>;
