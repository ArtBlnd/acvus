// let b = make();          // make() -> B
// f(1u8, b);               // f(u8, A) -> u8, f(u16, A) -> u16
// The candidates differ only at the first argument, so f reads that position
// alone; 1u8 leaves f(u8, A). The second parameter, A, is
// in the candidates' generalization, so b ⇝ A holds at once. B reaches A
// by no coercion: refused at that coercion constraint, with f decided.
extern type A;
extern type B;
extern fn make() -> B;
extern fn f(u8, A) -> u8;
extern fn f(u16, A) -> u16;

let `make()`;
let X;
let 1u8: u8;
let `f(..)`;
`make()` = make() @ make;
X = `make()`;
`f(..)` = f(1u8, X) @ f;

must fail;
assert f == f#0;
assert X: B;
assert failing [`X ~> f.GeneralizedParam(1)`];
