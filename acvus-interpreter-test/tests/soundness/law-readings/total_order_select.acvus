// expect pear|apple|3|fig
let xs = vec(["fig".to_string(), "pear".to_string(), "apple".to_string(), "pear".to_string()]);
let most = "".to_string();
let least = "zzz".to_string();
for x in &xs {
    if string::cmp(x, &most) > 0 {
        most = x.to_string();
    };
    if string::cmp(&least, x) > 0 {
        least = x.clone();
    };
}
let ns = vec([5, 3, 8, 3]);
let low = 100;
for n in &ns {
    if cmp(n, &low) < 0 {
        low = *n;
    };
}
let empty = vec(["q".to_string()]);
empty.pop();
let kept = "fig".to_string();
for x in &empty {
    if string::cmp(x, &kept) > 0 {
        kept = x.to_string();
    };
}
most + "|" + least + "|" + low.to_string() + "|" + kept
