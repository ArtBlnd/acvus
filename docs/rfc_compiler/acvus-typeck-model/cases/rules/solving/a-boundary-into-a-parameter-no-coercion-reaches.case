// let x = 1u16;
// take(x);                 // take(u8)
// x's type is an unknown, so 1u16 meets it: X ≥ u16. take's
// parameter u8 is decided, not an unknown, so x passing into it is a boundary,
// X ⇝ u8, which gives X no source: X is u16. A value
// entering by a boundary reaches by a coercion, and none goes from u16
// to u8, so the program is refused at that boundary.
extern fn take(u8);

let 1u16: u16;
let X;
let `take(x)`;
X = 1u16;
`take(x)` = take(X) @ take;

must fail;
assert X: u16;
assert failing [`X ~> take.Param(0)`];
