-- main --
=== main ===
     0 |   assign $order = r0
     1 |   r1 = fetch @weight
     2 |   assign @weight = r1
     3 |   r2 = fetch @alert_count
     4 |   assign @alert_count = r2
     5 |   r3 = fetch @threshold
     6 |   assign @threshold = r3
     7 |   r4 = fetch @user_id
     8 |   assign @user_id = r4
     9 |   r5 = take @user_id
    10 |   r6 = take $order
    11 |   r7 = call #0(r5) [r6 -> r8]
    12 |   assign $order = r8
    13 |   assign profile = r7
    14 |   r9 = take @user_id
    15 |   r10 = take $order
    16 |   r11 = call #1(r9) [r10 -> r12]
    17 |   assign $order = r12
    18 |   assign history = r11
    19 |   r13 = take profile
    20 |   r14 = take history
    21 |   r15 = take @weight
    22 |   r16 = call #2(r13, r14, r15)
    23 |   assign score = r16
    24 |   r17 = take profile
    25 |   r18 = take score
    26 |   r19 = call #3(r17, r18)
    27 |   assign label = r19
    28 |   r20 = take score
    29 |   r21 = take @threshold
    30 |   r22 = r20 > r21
    31 |   r23 = test r22 == true
    32 |   if r23 -> L0 else L1 join L1
    33 | L0:
    34 |   r24 = take @user_id
    35 |   r25 = take score
    36 |   r26 = take $order
    37 |   r27 = call #4(r24, r25) [r26 -> r28]
    38 |   assign $order = r28
    39 |   r29 = take @alert_count
    41 |   r30 = r29 + 1 (r31)
    42 |   assign @alert_count = r30
    43 |   jump L1
    44 | L1:
    46 |   r32 = take label
    47 |   assign @result_label = r32
    48 |   r33 = take score
    49 |   assign @result_score = r33
    50 |   r34 = take score
    51 |   r35 = take @result_label
    52 |   commit @result_label = r35
    53 |   r36 = take @weight
    54 |   commit @weight = r36 (not written)
    55 |   r37 = take @alert_count
    56 |   commit @alert_count = r37
    57 |   r38 = take @result_score
    58 |   commit @result_score = r38
    59 |   r39 = take @threshold
    60 |   commit @threshold = r39 (not written)
    61 |   r40 = take @user_id
    62 |   commit @user_id = r40 (not written)
    63 |   r41 = take $order
    64 |   return r34 [r41]

