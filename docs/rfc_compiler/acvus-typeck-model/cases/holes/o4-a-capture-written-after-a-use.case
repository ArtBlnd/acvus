//@ hole: O4
// let mut x = make_a();    // make_a() -> A, make_b() -> B; a cast A → B, a conversion B → A
// let put = |v| x = v;
// put(make_b());
// The call of put records into X only once it is decided and makes its
// instance, and X lies at none of its positions, so X does not wait for it: X is
// B where the instance records B ≤ X before X is solved, and A where after,
// refused at the instance's V ≤ X (l.287).
extern type A;
extern type B;
extern fn make_a() -> A;
extern fn make_b() -> B;
#[cast] extern fn up(A) -> B;
#[conversion] extern fn down(B) -> A;
extern fn probe(A);
extern fn probe(B);

group λ in run {
    let V;
    let `()`: ();
    let `λ result`;
    fn λ(V) -> `λ result`;
    `λ result` = `()`;
}
let X;
let `make_a()`;
let `|v| ..`: lambda λ;
let put;
let `make_b()`;
let `put(..)`;
`make_a()` = make_a() @ make_a;
X = `make_a()`;
put = `|v| ..`;
`make_b()` = make_b() @ make_b;
`put(..)` = (put)(`make_b()`) @ `put(..)`;
group λ {
    #[by_name] X = V;
}

outcome {
    must pass;
    assert X: B;
    assert failing [];
}
outcome {
    must fail;
    assert X: A;
    assert failing [`put(..)#λ/V <= X`];
}
