// let f = || { @n = 1u16; };   // @n is the host's u8; f is never called
// The store is in the lambda's text, its constraint: the coercion constraint
// 1u16 ⇝ @n, both of whose types are decided when solving starts. C holds the classes
// left unsolved, the disjunctive constraints left
// undecided and the constraints on them; this coercion constraint is on
// neither, so it is no original left in C, and its value must reach u8 by a
// coercion, which nothing gives, called or not.
group λ in run {
    let `λ result`;
    fn λ() -> `λ result`;
    let `@n`: host u8;
    let 1u16: u16;
    `@n` = 1u16;
    let `λ's ()`: ();
    `λ result` = `λ's ()`;
}
let `|| ..`: lambda λ;
let F;
F = `|| ..`;

must fail;
assert failing [`1u16 ~> @n`];
