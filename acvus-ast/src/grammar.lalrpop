use acvus_utils::{Astr, Interner, QualifiedRef};

use crate::ast::*;
use crate::span::Span;
use crate::token::Token;
use crate::error::{BlockStatement, ParseError, ParseErrorKind};
use crate::list::{ListElem, build_list};
use crate::parser::{BindLine, ForLine, build_assign, build_call, decoded, expr_to_pattern, block_closed, stated};
use crate::literal::{self, IntWidth, SuffixedInt};

grammar(interner: &Interner);

extern {
    type Location = usize;
    type Error = ParseError;

    enum Token {
        "int" => Token::IntLit(<i128>),
        "int_of" => Token::IntLitOf(<SuffixedInt>),
        "char" => Token::CharLit(<String>),
        "byte" => Token::ByteLit(<String>),
        "bytes" => Token::ByteStrLit(<String>),
        "float" => Token::FloatLit(<f64>),
        "string" => Token::StringLit(<String>),
        "ident" => Token::Ident(<Astr>),
        "$ref" => Token::ParamRef(<Astr>),
        "@ref" => Token::ContextRef(<Astr>),
        "true" => Token::True,
        "false" => Token::False,
        "_" => Token::Underscore,
        "Some" => Token::Some,
        "None" => Token::None,
        "Ok" => Token::Ok,
        "Err" => Token::Err,
        "let" => Token::Let,
        "if" => Token::If,
        "else" => Token::Else,
        "while" => Token::While,
        "for" => Token::For,
        "in" => Token::In,
        "break" => Token::Break,
        "continue" => Token::Continue,
        "return" => Token::Return,
        "anyorder" => Token::Anyorder,
        "match" => Token::Match,
        "mut" => Token::Mut,
        "as" => Token::As,
        "&" => Token::Amp,
        "+" => Token::Plus,
        "-" => Token::Minus,
        "*" => Token::Star,
        "/" => Token::Slash,
        "%" => Token::Percent,
        "!" => Token::Bang,
        "?" => Token::Question,
        "&&" => Token::AndAnd,
        "||" => Token::OrOr,
        "==" => Token::Eq,
        "!=" => Token::Neq,
        "<" => Token::Lt,
        ">" => Token::Gt,
        "<=" => Token::Lte,
        ">=" => Token::Gte,
        "=" => Token::Assign,
        "->" => Token::Arrow,
        "=>" => Token::FatArrow,
        ".." => Token::DotDot,
        "." => Token::Dot,
        "|" => Token::Pipe,
        "(" => Token::LParen,
        ")" => Token::RParen,
        "[" => Token::LBracket,
        "]" => Token::RBracket,
        "{" => Token::LBrace,
        "}" => Token::RBrace,
        "," => Token::Comma,
        ":" => Token::Colon,
        "::" => Token::DoubleColon,
        ";" => Token::Semicolon,
        "fmt_start" => Token::FmtStringStart(<String>),
        "fmt_mid" => Token::FmtStringMid(<String>),
        "fmt_end" => Token::FmtStringEnd(<String>),
    }
}

// ── Script rule ──────────────────────────────────────────────────────
//
// One statement grammar for every block: `let` binds, `x = e;` assigns.

pub Script: Script = {
    <l:@L> <body:Body> <r:@R> =>
        Script { id: AstId::alloc(), stmts: body.0, tail: body.1.map(Box::new), span: Span::new(l, r) }
};

// ── Bodies ─────────────────────────────────────────────────────────────
//
// An `if` or a `match` that begins a statement is the whole statement, as
// in Rust: it ends at its `}`, with or without a `;`, and no operator
// continues it. Without the `;`, the token after the `}` decides what it
// is: the `}` closing the body, or the end of the script, makes it the
// body's tail; anything else makes it a statement. With the `;` it is a
// statement, the way a body that ends in one discards its value.
//
// The body rules are inlined into the rules that hold them, so a script's
// end and a block's `}` stay apart: a stray `}` in a script is refused where
// a statement was expected, not as input after the end.

// Statements and an optional tail: a script, an `if` or `else` block.
#[inline]
Body: (Vec<Stmt>, Option<Expr>) = {
    => (vec![], None),
    <stmts:Stmts> => (stmts, None),
    <body:TailedBody> => (body.0, Some(body.1)),
};

// Statements and a tail: a block expression.
#[inline]
TailedBody: (Vec<Stmt>, Expr) = {
    <tail:StmtExpr> => (vec![], tail),
    <stmts:Stmts> <tail:StmtExpr> => (stmts, tail),
    <open:Open> <tail:StmtExpr> => (stated(open), tail),
    Open,
};

// Statements and no tail: a `while`, `for` or `anyorder` block.
#[inline]
LoopBody: Vec<Stmt> = {
    => vec![],
    Stmts,
    <open:Open> => stated(open),
};

// Statements that end in a `;` or in a `while`, `for` or `anyorder` block.
Stmts: Vec<Stmt> = {
    <stmt:Stmt> => vec![stmt],
    <mut stmts:Stmts> <stmt:Stmt> => { stmts.push(stmt); stmts },
    <open:Open> <stmt:Stmt> => { let mut stmts = stated(open); stmts.push(stmt); stmts },
};

// Statements that end in an `if` or a `match` with no `;` after it, whose
// place the next token decides.
Open: (Vec<Stmt>, Expr) = {
    <last:BranchExpr> => (vec![], last),
    <stmts:Stmts> <last:BranchExpr> => (stmts, last),
    <open:Open> <last:BranchExpr> => (stated(open), last),
};

// The expressions that stand as a statement without `;`. A block is not
// one: a statement that begins with `{` reads on, so `{ [5, 6] }[1]` is `6`.
BranchExpr: Expr = {
    MatchExpr,
    IfExpr,
};

// ── match ──────────────────────────────────────────────────────────────
//
// `match e { P => e, P => { stmts; tail }, _ => e }` is one dispatch over
// `e` (RFC-0051): the scrutinee is evaluated once, every arm has the type
// of the whole, and exhaustiveness is decided in `validate`.

MatchExpr: Expr = {
    <l:@L> "match" <scrutinee:Expr> "{" <arms:CommaSep<MatchArmRule>> "}" <r:@R> =>
        Expr::Match {
            id: AstId::alloc(),
            scrutinee: Box::new(scrutinee),
            arms,
            span: Span::new(l, r),
        },
};

MatchArmRule: MatchExprArm = {
    // `P => { stmts; }` — an arm run for its effect; its type is Unit.
    <l:@L> <pattern:ArmPattern> "=>" "{" <body:Stmts> "}" <r:@R> =>
        MatchExprArm { id: AstId::alloc(), pattern, body, tail: None, span: Span::new(l, r) },
    // `P => e` — including `P => { stmts; tail }`, which is a block expression.
    <l:@L> <pattern:ArmPattern> "=>" <e:Expr> <r:@R> =>
        MatchExprArm { id: AstId::alloc(), pattern, body: vec![], tail: Some(Box::new(e)), span: Span::new(l, r) },
};

// An arm's pattern: every pattern the grammar already has, plus `_`.
ArmPattern: Pattern = {
    <l:@L> "_" <r:@R> => Pattern::Wildcard { id: AstId::alloc(), span: Span::new(l, r) },
    <e:Expr> =>? Ok(expr_to_pattern(&e)?),
};

// If expression (recursive via else-if chain).
IfExpr: Expr = {
    // if cond { body; tail } else ...
    <l:@L> "if" <cond:Expr> "{" <body:Body> "}"
        <eb:ElseBranch?> <r:@R> =>
        Expr::If {
            id: AstId::alloc(),
            cond: Box::new(cond),
            then_body: body.0,
            then_tail: body.1.map(Box::new),
            else_branch: eb.map(Box::new),
            span: Span::new(l, r),
        },
    // if let pattern = source { body; tail } else ...
    <l:@L> "if" "let" <lhs:Expr> "=" <rhs:Expr> "{" <body:Body> "}"
        <eb:ElseBranch?> <r:@R> =>?
        Ok(Expr::IfLet {
            id: AstId::alloc(),
            pattern: expr_to_pattern(&lhs)?,
            source: Box::new(rhs),
            then_body: body.0,
            then_tail: body.1.map(Box::new),
            else_branch: eb.map(Box::new),
            span: Span::new(l, r),
        }),
};

ElseBranch: ElseBranch = {
    "else" <e:IfExpr> => ElseBranch::ElseIf(e),
    <l:@L> "else" "{" <body:Body> "}" <r:@R> =>
        ElseBranch::Else {
            body: body.0,
            tail: body.1.map(Box::new),
            span: Span::new(l, r),
        },
};

Stmt: Stmt = {
    // let x = expr;
    <l:@L> "let" <binder:Binder> "=" <expr:Expr> ";" <r:@R> =>
        Stmt::LetBind { id: AstId::alloc(), binder, expr, span: Span::new(l, r) },
    // let x;
    <l:@L> "let" <binder:Binder> ";" <r:@R> =>
        Stmt::LetUninit { id: AstId::alloc(), binder, span: Span::new(l, r) },
    // while cond { body }
    <l:@L> "while" <cond:Expr> "{" <body:LoopBody> "}" <r:@R> <semicolon:StraySemicolon?> =>? {
        block_closed(BlockStatement::While, semicolon)?;
        Ok(Stmt::While { id: AstId::alloc(), cond, body, span: Span::new(l, r) })
    },
    // while let pattern = source { body }
    <l:@L> "while" "let" <lhs:Expr> "=" <rhs:Expr> "{" <body:LoopBody> "}" <r:@R> <semicolon:StraySemicolon?> =>? {
        block_closed(BlockStatement::While, semicolon)?;
        Ok(Stmt::WhileLet {
            id: AstId::alloc(),
            pattern: expr_to_pattern(&lhs)?,
            source: rhs,
            body,
            span: Span::new(l, r),
        })
    },
    // for x in &v { body } | for x in a { body } | for i in lo..hi { body }
    <l:@L> "for" <binder:Binder> "in" <head:ForHead> "{" <body:LoopBody> "}" <r:@R> <semicolon:StraySemicolon?> =>? {
        block_closed(BlockStatement::For, semicolon)?;
        Ok(Stmt::For { id: AstId::alloc(), callee_id: AstId::alloc(), binder, head, body, span: Span::new(l, r) })
    },
    // break; | continue;  -- the innermost loop, no labels (RFC-0057 rule 4)
    <l:@L> "break" ";" <r:@R> =>
        Stmt::Break { id: AstId::alloc(), span: Span::new(l, r) },
    <l:@L> "continue" ";" <r:@R> =>
        Stmt::Continue { id: AstId::alloc(), span: Span::new(l, r) },
    // anyorder { body }
    <l:@L> "anyorder" "{" <body:LoopBody> "}" <r:@R> <semicolon:StraySemicolon?> =>? {
        block_closed(BlockStatement::Anyorder, semicolon)?;
        Ok(Stmt::Anyorder { id: AstId::alloc(), body, span: Span::new(l, r) })
    },
    // `place = e;` — a place is a name, an `@context` or a `$parameter`
    // under any path of `.field` and `[index]` steps (RFC-0047).
    <l:@L> <lhs:StmtExpr> "=" <rhs:Expr> ";" <r:@R> =>? build_assign(lhs, rhs, Span::new(l, r)),
    // expression statement
    <e:StmtExpr> ";" => Stmt::Expr(e),
    <e:BranchExpr> ";" => Stmt::Expr(e),
};

// A `;` after the `}` closing a block statement, which its rule reads so that it
// is reported as what it is: no statement begins with `;`, so reading it
// here takes nothing from another rule.
StraySemicolon: Span = <l:@L> ";" <r:@R> => Span::new(l, r);

// `lo..hi` is a `for` head and not a value: there is no `Range` type, so
// `..` appears in no expression rule (RFC-0057 rule 1).
pub ForHead: ForHead = {
    <lo:Expr> ".." <hi:Expr> => ForHead::Range { lo, hi },
    <e:Expr> => ForHead::Value(e),
};

// ── Template lines (RFC-0071) ──────────────────────────────────────────
//
// A `%` line is one statement of the rules above, without its `;` and
// without the braces that open or close a block. The line's leading
// keyword names which rule reads the rest of it, so no rule here has to
// tell a block head from a complete statement.

// A `%` line that opens no block.
pub TemplateStmt: Stmt = {
    <l:@L> "let" <binder:Binder> "=" <expr:Expr> <r:@R> =>
        Stmt::LetBind { id: AstId::alloc(), binder, expr, span: Span::new(l, r) },
    <l:@L> "let" <binder:Binder> <r:@R> =>
        Stmt::LetUninit { id: AstId::alloc(), binder, span: Span::new(l, r) },
    <l:@L> "break" <r:@R> =>
        Stmt::Break { id: AstId::alloc(), span: Span::new(l, r) },
    <l:@L> "continue" <r:@R> =>
        Stmt::Continue { id: AstId::alloc(), span: Span::new(l, r) },
    <l:@L> <lhs:Expr> "=" <rhs:Expr> <r:@R> =>? build_assign(lhs, rhs, Span::new(l, r)),
    <e:Expr> => Stmt::Expr(e),
};

// `x in head`, what follows the `for` of a `% for` line.
pub ForLine: ForLine = {
    <binder:Binder> "in" <head:ForHead> => ForLine { binder, head },
};

// `pattern = source`, what follows the `let` of a `% if let` or
// `% while let` line.
pub BindLine: BindLine = {
    <lhs:Expr> "=" <rhs:Expr> =>? Ok(BindLine { pattern: expr_to_pattern(&lhs)?, source: rhs }),
};

// The pattern of a `% pattern =>` arm line, `_` included.
pub ArmLine: Pattern = {
    ArmPattern,
};

// ── Expressions (precedence climbing) ──────────────────────────────────
//
// Each level is written once over `Lead`, the primary its leftmost operand
// may be. An operand anywhere else is the full level.

pub Expr: Expr = {
    ExprFrom<PrimaryExpr>,
};

// The expression a statement or a tail begins with: its leftmost operand is
// no `if` or `match`, since such an expression is a statement of its own
// (`Open` above).
StmtExpr: Expr = {
    ExprFrom<PlainPrimary>,
};

ExprFrom<Lead>: Expr = {
    // Lambda: |params| -> body (body is full Expr, so pipes are allowed inside)
    <l:@L> "|" <params:CommaSep<Binder>> "|" "->" <body:Expr> <r:@R> =>
        Expr::Lambda {
            id: AstId::alloc(),
            params,
            body: Box::new(body),
            span: Span::new(l, r),
        },
    // An expression and not a statement, so that it stands where a value is
    // read; `return e;` is then the expression-statement rule. There is no
    // `return;`: every body returns a value (RFC-0054).
    <l:@L> "return" <e:Expr> <r:@R> =>
        Expr::Return { id: AstId::alloc(), value: Box::new(e), span: Span::new(l, r) },
    PipeExpr<Lead>,
};

// Pipe: left-associative (lowest precedence among non-lambda)
PipeExpr<Lead>: Expr = {
    <l:@L> <left:PipeExpr<Lead>> "|" <right:OrExpr<PrimaryExpr>> <r:@R> =>
        Expr::Pipe {
            id: AstId::alloc(),
            left: Box::new(left),
            right: Box::new(right),
            span: Span::new(l, r),
        },
    OrExpr<Lead>,
};

Binder: Binder = {
    <l:@L> <name:"ident"> <r:@R> => Binder { id: AstId::alloc(), name, span: Span::new(l, r) },
};

// Logical Or: left-associative
OrExpr<Lead>: Expr = {
    <l:@L> <left:OrExpr<Lead>> "||" <right:AndExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Or, right: Box::new(right), span: Span::new(l, r) },
    AndExpr<Lead>,
};

// Logical And: left-associative
AndExpr<Lead>: Expr = {
    <l:@L> <left:AndExpr<Lead>> "&&" <right:CompExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::And, right: Box::new(right), span: Span::new(l, r) },
    CompExpr<Lead>,
};

// Comparison: ==, !=, <, >, <=, >=
CompExpr<Lead>: Expr = {
    <l:@L> <left:CompExpr<Lead>> "==" <right:AddExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Eq, right: Box::new(right), span: Span::new(l, r) },
    <l:@L> <left:CompExpr<Lead>> "!=" <right:AddExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Neq, right: Box::new(right), span: Span::new(l, r) },
    <l:@L> <left:CompExpr<Lead>> "<" <right:AddExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Lt, right: Box::new(right), span: Span::new(l, r) },
    <l:@L> <left:CompExpr<Lead>> ">" <right:AddExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Gt, right: Box::new(right), span: Span::new(l, r) },
    <l:@L> <left:CompExpr<Lead>> "<=" <right:AddExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Lte, right: Box::new(right), span: Span::new(l, r) },
    <l:@L> <left:CompExpr<Lead>> ">=" <right:AddExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Gte, right: Box::new(right), span: Span::new(l, r) },
    AddExpr<Lead>,
};

// Add/Sub: left-associative
AddExpr<Lead>: Expr = {
    <l:@L> <left:AddExpr<Lead>> "+" <right:MulExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Add, right: Box::new(right), span: Span::new(l, r) },
    <l:@L> <left:AddExpr<Lead>> "-" <right:MulExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Sub, right: Box::new(right), span: Span::new(l, r) },
    MulExpr<Lead>,
};

// Mul/Div: left-associative
MulExpr<Lead>: Expr = {
    <l:@L> <left:MulExpr<Lead>> "*" <right:CastExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Mul, right: Box::new(right), span: Span::new(l, r) },
    <l:@L> <left:MulExpr<Lead>> "/" <right:CastExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Div, right: Box::new(right), span: Span::new(l, r) },
    <l:@L> <left:MulExpr<Lead>> "%" <right:CastExpr<PrimaryExpr>> <r:@R> =>
        Expr::BinaryOp { id: AstId::alloc(), left: Box::new(left), op: BinOp::Mod, right: Box::new(right), span: Span::new(l, r) },
    CastExpr<Lead>,
};

// Cast: `e as T`, left-associative, between the unary operators and `*`,
// exactly where Rust binds it (RFC-0049).
CastExpr<Lead>: Expr = {
    <l:@L> <e:CastExpr<Lead>> "as" <tl:@L> <target:"ident"> <r:@R> =>
        Expr::Cast {
            id: AstId::alloc(),
            expr: Box::new(e),
            target,
            target_span: Span::new(tl, r),
            span: Span::new(l, r),
        },
    UnaryExpr<Lead>,
};

// Unary: -x, !x, *r, &place, &mut place (RFC-0018)
UnaryExpr<Lead>: Expr = {
    <l:@L> "-" <e:UnaryExpr<PrimaryExpr>> <r:@R> =>
        Expr::UnaryOp { id: AstId::alloc(), op: UnaryOp::Neg, operand: Box::new(e), span: Span::new(l, r) },
    <l:@L> "!" <e:UnaryExpr<PrimaryExpr>> <r:@R> =>
        Expr::UnaryOp { id: AstId::alloc(), op: UnaryOp::Not, operand: Box::new(e), span: Span::new(l, r) },
    <l:@L> "*" <e:UnaryExpr<PrimaryExpr>> <r:@R> =>
        Expr::UnaryOp { id: AstId::alloc(), op: UnaryOp::Deref, operand: Box::new(e), span: Span::new(l, r) },
    <l:@L> "&" "mut" <place:UnaryExpr<PrimaryExpr>> <r:@R> =>
        Expr::Borrow { id: AstId::alloc(), mutable: true, place: Box::new(place), span: Span::new(l, r) },
    <l:@L> "&" <place:UnaryExpr<PrimaryExpr>> <r:@R> =>
        Expr::Borrow { id: AstId::alloc(), mutable: false, place: Box::new(place), span: Span::new(l, r) },
    PostfixExpr<Lead>,
};

// Postfix: field access `.field` and function call `f(args)`
// A field is never a callee: `recv.f(args)` is a method call, and a
// closure held in a field is called as `(recv.f)(args)` (RFC-0030).
PostfixExpr<Lead>: Expr = {
    <l:@L> <obj:PostfixExpr<Lead>> "." <f:"ident"> <r:@R> =>
        Expr::FieldAccess { id: AstId::alloc(), object: Box::new(obj), field: f, span: Span::new(l, r) },
    // `e?`: the Ok or Some payload, or an early return of the Err or None (RFC-0038).
    <l:@L> <inner:PostfixExpr<Lead>> "?" <r:@R> =>
        Expr::Try { id: AstId::alloc(), inner: Box::new(inner), span: Span::new(l, r) },
    // `a[i]`: a place, binding like `.field` (RFC-0047). A statement that
    // begins with `[` is an array literal; every statement ends in `;` or
    // in a block, so the two never meet.
    <l:@L> <obj:PostfixExpr<Lead>> "[" <index:Expr> "]" <r:@R> =>
        Expr::Index {
            id: AstId::alloc(),
            callee_id: AstId::alloc(),
            object: Box::new(obj),
            index: Box::new(index),
            span: Span::new(l, r),
        },
    CalleeExpr<Lead>,
};

CalleeExpr<Lead>: Expr = {
    <l:@L> <recv:PostfixExpr<Lead>> "." <name:"ident"> "(" <args:CommaSep<CallArg>> ")" <r:@R> =>
        Expr::MethodCall { id: AstId::alloc(), callee_id: AstId::alloc(), receiver: Box::new(recv), name, args, span: Span::new(l, r) },
    <l:@L> <func:CalleeExpr<Lead>> "(" <args:CommaSep<CallArg>> ")" <r:@R> =>
        build_call(func, args, Span::new(l, r)),
    Lead,
};

CallArg: Expr = {
    Expr,
};

// Primary expressions
PrimaryExpr: Expr = {
    PlainPrimary,
    // `match` and `if` are operands: an operator's side, a call argument, a
    // list element, a field value, a pipe stage — wherever an expression
    // stands, with the braces as the delimiter (RFC-0051).
    BranchExpr,
};

// Every primary but an `if` or a `match`.
PlainPrimary: Expr = {
    // `Enum::Tag`, and the callee of `ns::f(args)`: the checker tells a
    // namespace from an enum name (RFC-0030). It is a primary, so every
    // postfix — `?` included — follows a qualified call.
    <l:@L> <ename:"ident"> "::" <tag:"ident"> <r:@R> =>
        Expr::Variant { id: AstId::alloc(), enum_name: Some(ename), tag, payload: None, span: Span::new(l, r) },
    <l:@L> <name:"ident"> <r:@R> =>
        Expr::Ident { id: AstId::alloc(), name: QualifiedRef::root(name), ref_kind: RefKind::Value, span: Span::new(l, r) },
    <l:@L> <name:"$ref"> <r:@R> =>
        Expr::Ident { id: AstId::alloc(), name: QualifiedRef::root(name), ref_kind: RefKind::ExternParam, span: Span::new(l, r) },
    <l:@L> <name:"@ref"> <r:@R> =>
        Expr::ContextRef { id: AstId::alloc(), name: QualifiedRef::root(name), span: Span::new(l, r) },
    <l:@L> <n:"int"> <r:@R> =>
        Expr::Literal { id: AstId::alloc(), value: Literal::Int(n), span: Span::new(l, r) },
    <l:@L> <n:"int_of"> <r:@R> =>
        Expr::Literal { id: AstId::alloc(), value: Literal::IntOf(n), span: Span::new(l, r) },
    <l:@L> <t:"char"> <r:@R> =>?
        decoded(literal::decode_char(&t), Span::new(l, r)).map(|c|
            Expr::Literal { id: AstId::alloc(), value: Literal::Char(c), span: Span::new(l, r) }),
    <l:@L> <t:"byte"> <r:@R> =>?
        decoded(literal::decode_byte(&t), Span::new(l, r)).map(|b|
            Expr::Literal { id: AstId::alloc(), value: Literal::IntOf(SuffixedInt { value: i128::from(b), width: IntWidth::U8 }), span: Span::new(l, r) }),
    <l:@L> <t:"bytes"> <r:@R> =>?
        decoded(literal::decode_bytes(&t), Span::new(l, r)).map(|b|
            Expr::Literal { id: AstId::alloc(), value: Literal::Bytes(b), span: Span::new(l, r) }),
    <l:@L> <n:"float"> <r:@R> =>
        Expr::Literal { id: AstId::alloc(), value: Literal::Float(n), span: Span::new(l, r) },
    <l:@L> <s:"string"> <r:@R> =>?
        decoded(literal::decode_str(&s), Span::new(l, r)).map(|s|
            Expr::Literal { id: AstId::alloc(), value: Literal::String(s), span: Span::new(l, r) }),
    <l:@L> "true" <r:@R> =>
        Expr::Literal { id: AstId::alloc(), value: Literal::Bool(true), span: Span::new(l, r) },
    <l:@L> "false" <r:@R> =>
        Expr::Literal { id: AstId::alloc(), value: Literal::Bool(false), span: Span::new(l, r) },

    // Variant constructors: Some(expr) and None
    <l:@L> "Some" "(" <inner:Expr> ")" <r:@R> =>
        Expr::Variant { id: AstId::alloc(), enum_name: None, tag: interner.intern("Some"), payload: Some(Box::new(inner)), span: Span::new(l, r) },
    <l:@L> "None" <r:@R> =>
        Expr::Variant { id: AstId::alloc(), enum_name: None, tag: interner.intern("None"), payload: None, span: Span::new(l, r) },
    <l:@L> "Ok" "(" <inner:Expr> ")" <r:@R> =>
        Expr::Variant { id: AstId::alloc(), enum_name: None, tag: interner.intern("Ok"), payload: Some(Box::new(inner)), span: Span::new(l, r) },
    <l:@L> "Err" "(" <inner:Expr> ")" <r:@R> =>
        Expr::Variant { id: AstId::alloc(), enum_name: None, tag: interner.intern("Err"), payload: Some(Box::new(inner)), span: Span::new(l, r) },

    // Parenthesized expression or tuple
    <l:@L> "(" <items:CommaSep<TupleElemRule>> ")" <r:@R> => {
        let span = Span::new(l, r);
        // Single non-wildcard element → Paren (grouping)
        if items.len() == 1 {
            match items.into_iter().next().unwrap() {
                TupleElem::Expr(e) => Expr::Paren { id: AstId::alloc(), inner: Box::new(e), span },
                TupleElem::Wildcard(_) => Expr::Tuple { id: AstId::alloc(), elements: vec![TupleElem::Wildcard(span)], span },
            }
        } else {
            Expr::Tuple { id: AstId::alloc(), elements: items, span }
        }
    },

    // List: [a, b, c], [a, b, ..], [.., a, b], [a, .., b]
    <l:@L> "[" <items:CommaSep<ListElem>> "]" <r:@R> =>?
        build_list(items, Span::new(l, r)),

    // Block expression: { stmt; stmt; expr } or { expr }
    <l:@L> "{" <body:TailedBody> "}" <r:@R> =>
        Expr::Block { id: AstId::alloc(), stmts: body.0, tail: Box::new(body.1), span: Span::new(l, r) },

    // Object literal: { field1, $field2, } — trailing comma required (empty {} allowed)
    <l:@L> "{" <fields:(<ObjectField> ",")*> "}" <r:@R> =>
        Expr::Object { id: AstId::alloc(), fields, span: Span::new(l, r) },

    // Format string: "hello {{ name }}, age {{ age | to_string }}"
    // Desugars to BinOp::Add chain: "hello " + name + ", age " + (age | to_string)
    <sl:@L> <start:"fmt_start"> <sr:@R> <first:Expr> <rest:FmtMidPair*> <el:@L> <end:"fmt_end"> <er:@R> =>? {
        let mut parts: Vec<Expr> = Vec::new();

        // Start text segment (span = start token position)
        let start_span = Span::new(sl, sr);
        if !start.is_empty() {
            let start = decoded(literal::decode_str(&start), start_span)?;
            parts.push(Expr::Literal { id: AstId::alloc(), value: Literal::String(start), span: start_span });
        }
        parts.push(first);

        // Mid text + expr pairs (each mid has its own span)
        for (mid_span, mid, expr) in rest {
            if !mid.is_empty() {
                let mid = decoded(literal::decode_str(&mid), mid_span)?;
                parts.push(Expr::Literal { id: AstId::alloc(), value: Literal::String(mid), span: mid_span });
            }
            parts.push(expr);
        }

        // End text segment (span = end token position)
        let end_span = Span::new(el, er);
        if !end.is_empty() {
            let end = decoded(literal::decode_str(&end), end_span)?;
            parts.push(Expr::Literal { id: AstId::alloc(), value: Literal::String(end), span: end_span });
        }

        // Fold into BinOp::Add chain
        let mut iter = parts.into_iter();
        let mut acc = iter.next().unwrap();
        for part in iter {
            let merged = acc.span().merge(part.span());
            acc = Expr::BinaryOp {
                id: AstId::alloc(),
                left: Box::new(acc),
                op: BinOp::Add,
                right: Box::new(part),
                span: merged,
            };
        }
        Ok(acc)
    },
};

// Format string mid segment: captures token span for the text literal.
FmtMidPair: (Span, String, Expr) = {
    <ml:@L> <mid:"fmt_mid"> <mr:@R> <expr:Expr> => (Span::new(ml, mr), mid, expr),
};

// Tuple element: an expression or `_`
TupleElemRule: TupleElem = {
    <e:Expr> => TupleElem::Expr(e),
    <l:@L> "_" <r:@R> => TupleElem::Wildcard(Span::new(l, r)),
};

// List element: an expression or `..`
ListElem: ListElem = {
    <e:Expr> => ListElem::Expr(e),
    <l:@L> ".." <r:@R> => ListElem::Rest(Span::new(l, r)),
};

// Object field: `key: expr`, or shorthand `name`, `$name`, `@name`
ObjectField: ObjectExprField = {
    <l:@L> <key:"ident"> ":" <value:Expr> <r:@R> =>
        ObjectExprField { id: AstId::alloc(), key, value, span: Span::new(l, r) },
    <l:@L> <name:"ident"> <r:@R> => {
        let span = Span::new(l, r);
        ObjectExprField {
            id: AstId::alloc(),
            key: name,
            value: Expr::Ident { id: AstId::alloc(), name: QualifiedRef::root(name), ref_kind: RefKind::Value, span },
            span,
        }
    },
    <l:@L> <name:"$ref"> <r:@R> => {
        let span = Span::new(l, r);
        ObjectExprField {
            id: AstId::alloc(),
            key: name,
            value: Expr::Ident { id: AstId::alloc(), name: QualifiedRef::root(name), ref_kind: RefKind::ExternParam, span },
            span,
        }
    },
    <l:@L> <name:"@ref"> <r:@R> => {
        let span = Span::new(l, r);
        ObjectExprField {
            id: AstId::alloc(),
            key: name,
            value: Expr::ContextRef { id: AstId::alloc(), name: QualifiedRef::root(name), span },
            span,
        }
    },
};

// ── Helpers ────────────────────────────────────────────────────────────

CommaSep<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => { v.push(e); v }
    }
};
