//@ spec: l.186, l.246
// let mut out = buf();
// let emit = |x| write(&mut out, x);   // write(&mut Buf, A), write(&mut Buf, B); a cast A → B
// emit(make_a()); emit(make_b());
// x is the lambda's own, write's choice its constraint at x alone, so each call
// decides write by what it passes: A, then B. Before G4 x was the environment's,
// A ⊔ B = B, and write was decided once as the second (note 17).
extern type Buf;
extern type A;
extern type B;
extern fn buf() -> Buf;
extern fn make_a() -> A;
extern fn make_b() -> B;
#[cast] extern fn up(A) -> B;
extern fn write(&mut Buf, A);
extern fn write(&mut Buf, B);
group λ in run {
    let X;
    let `λ result`;
    fn λ(X) -> `λ result`;
    let `&mut out`;
    let `write(..)`;
    `λ result` = `write(..)`;
}
let OUT;
let `buf()`;
`buf()` = buf() @ buf;
OUT = `buf()`;
let `|x| ..`: lambda λ;
let EMIT;
EMIT = `|x| ..`;
let `make_a()`;
let `make_b()`;
`make_a()` = make_a() @ make_a;
`make_b()` = make_b() @ make_b;
let `emit(a)`;
let `emit(b)`;
`emit(a)` = (EMIT)(`make_a()`) @ `emit 1`;
`emit(b)` = (EMIT)(`make_b()`) @ `emit 2`;
group λ {
    `&mut out` = &mut OUT @ `&mut out`;
    `write(..)` = write(`&mut out`, X) @ write;
}

must pass;
