//@ spec: l.296
// let x = 1u8;
// let r = &x;
// take(&r);                // take(&u16)
// r is &X, so &r lends X itself (l.296). The boundary into &u16 records
// X ⇝ u16 toward a type the declaration writes, which decides no value
// (l.278): X is u8, and &u8 reaches &u16 by no coercion (l.280).
extern fn take(&u16);

let X;
let 1u8: u8;
let `&x`;
let R;
let `&r`;
let `take(..)`;
X = 1u8;
`&x` = &X @ `&x`;
R = `&x`;
`&r` = &R @ `&r`;
`take(..)` = take(`&r`) @ take;

must fail;
assert `&x` == lend & place;
assert `&r` == lend & through &;
assert failing [`&r ~> take.Param(0)`];
