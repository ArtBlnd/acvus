//@ spec: l.226, l.235, l.280, l.293, l.301
// let mut x = 1u8;
// let r = &mut x;
// let f = || *r = 2u16;
// f();
// The write in the lambda reaches X, an unknown of the enclosing binding group,
// through the reference r, so it is a boundary, 2u16 ⇝ *r (l.226, l.235), and
// the Deref makes *r X. A boundary is no source (l.280), so X is u8, from 1u8
// alone, and the value entering by the boundary reaches u8 by no coercion
// (l.293): refused at that boundary (l.301).
group λ in run {
    let `*r`;
    let 2u16: u16;
    let `()`: ();
    let `λ result`;
    fn λ() -> `λ result`;
    `λ result` = `()`;
}
let X;
let 1u8: u8;
let `&mut x`;
let R;
let `|| ..`: lambda λ;
let f;
let `f()`;
X = 1u8;
`&mut x` = &mut X @ `&mut x`;
R = `&mut x`;
f = `|| ..`;
`f()` = (f)() @ `f()`;
group λ {
    `*r` = *R @ `*r`;
    #[through_ref] `*r` = 2u16;
}

must fail;
assert X: u8;
assert `&mut x` == lend &mut place;
assert `f()` == calls {λ};
assert failing [`f()#λ/2u16 ⇝ f()#λ/*r`];
