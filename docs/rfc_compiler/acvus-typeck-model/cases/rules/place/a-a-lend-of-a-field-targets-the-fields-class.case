//@ spec: l.294, l.296
// let a;
// a.x = 1u8;
// take(&a.x);              // take(&u16)
// The place a.x has the type the projection names (l.294), so the lend targets
// that class by an equation (l.296). The boundary into &u16 records a.x ⇝ u16
// toward a type the declaration writes, which decides no value (l.278): a.x is
// u8, and &u8 reaches &u16 by no coercion (l.280).
extern fn take(&u16);

let A;
let `a.x`;
let 1u8: u8;
let `&a.x`;
let `take(..)`;
`a.x` = A.x @ `a.x`;
`a.x` = 1u8;
`&a.x` = &`a.x` @ lend;
`take(..)` = take(`&a.x`) @ take;

must fail;
assert `a.x` == applied;
assert lend == lend & place;
assert failing [`&a.x ~> take.Param(0)`];
