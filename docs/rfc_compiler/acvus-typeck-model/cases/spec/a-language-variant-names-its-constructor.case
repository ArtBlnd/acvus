// let o; if let Some(x) = o { }
// O's only source is the structure constraint "variant Some", so O takes the constructor of the
// member it names, Option, though Some is not visible;
// the payload nothing enters falls back to !.
let O;
let `Some.0`;
let X;
`Some.0` = O as Some @ Some;
X = bind `Some.0` via [Some] @ x;

must pass;
assert O: Option<!>;
