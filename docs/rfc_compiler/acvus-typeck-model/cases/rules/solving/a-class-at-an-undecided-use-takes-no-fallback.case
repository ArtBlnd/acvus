// let x;
// let r = f(x);            // f(u8) -> u8, f(u16) -> u16
// No lower bound, no domain and no requirement is on X, so X takes `!` at
// the fixpoint. The argument of f then holds `!`, so by the never rule f is
// never, and the program is accepted.
extern fn f(u8) -> u8;
extern fn f(u16) -> u16;

let X;
let R;
R = f(X) @ f;

must pass;
assert f == never;
assert X: !;
