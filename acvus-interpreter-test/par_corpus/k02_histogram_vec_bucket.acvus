// id: K02
// family: keyed
// desc: histogram into a vec, `h[x % 4] = h[x % 4] + 1`: a non-injective index joined by a commutative `+`
// expect: 2,1,1,2
let xs = vec([4u64, 1u64, 8u64, 3u64, 6u64, 7u64]);
let h = vec([0, 0, 0, 0]);
for x in &xs {
    let b = *x % 4u64;
    h[b] = h[b] + 1;
}
h.into_iter().map(|x| -> x.to_string()).join(",".to_string())
