// let t = (1u8, 2u8);
// t == t;                  // core::eq(&u8, &u8) -> bool, the impl of eq<T>(&T, &T) -> bool at u8
// == is a use of core::eq, each operand lent. At the structural type
// (u8, u8) the candidate of the generic function is eq called at each part.
extern fn core::eq(&u8, &u8) -> bool;
let C0;
let C1;
let `(1u8, 2u8)`: (C0, C1);
let 1u8: u8;
let 2u8: u8;
C0 = 1u8;
C1 = 2u8;
let T;
T = `(1u8, 2u8)`;
let `&t`;
`&t` = &T @ `&t`;
let `&t 2`;
`&t 2` = &T @ `&t 2`;
let `t == t`;
`t == t` = core::eq(`&t`, `&t 2`) @ eq;

must pass;
assert outcomes 1;
assert T: (u8, u8);
assert `t == t`: bool;
