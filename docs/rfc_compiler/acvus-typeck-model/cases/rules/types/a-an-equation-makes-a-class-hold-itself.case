//@ spec: l.41, l.268, l.272
// let a;
// f(&a, &a);               // f<T>(&T, &Vec<T>)
// Each lend's target is A, which is a reference in no reading. Each argument
// passes into a reference the declaration gives, a boundary whose target is
// invariant (l.277): A = T and A = Vec<T>. A's class then holds Vec with
// itself as its part, which no finite term is (l.41, l.268).
extern type Vec<T>;
extern fn f<T>(&T, &Vec<T>);

let A;
let `&a 1`;
let `&a 2`;
let `f(..)`;
`&a 1` = &A @ `lend 1`;
`&a 2` = &A @ `lend 2`;
`f(..)` = f(`&a 1`, `&a 2`) @ f;

must fail;
assert A: none;
