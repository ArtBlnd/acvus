// let r = f(never());      // never() -> !; f(u8) -> u8, f(u16) -> u16
// The argument reads as !, so the use is decided with the result !.
extern fn never() -> !;
extern fn f(u8) -> u8;
extern fn f(u16) -> u16;

let `never()`;
let R;
`never()` = never() @ never;
R = f(`never()`) @ f;

must pass;
assert f == never;
assert R: !;
