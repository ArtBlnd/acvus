    ; r8 (v7) : String
    ; r9 (v3) : String
    ; r10 (v2) : Int
    ; r11 (v1) : Int
    ; r12 (v12) : String

-- main --
=== main ===
     0 |   assign $order = r0
     1 |   r1 = fetch @result_label
     2 |   assign @result_label = r1
     3 |   r2 = fetch @weight
     4 |   assign @weight = r2
     5 |   r3 = fetch @alert_count
     6 |   assign @alert_count = r3
     7 |   r4 = fetch @result_score
     8 |   assign @result_score = r4
     9 |   r5 = fetch @threshold
    10 |   assign @threshold = r5
    11 |   r6 = fetch @user_id
    12 |   assign @user_id = r6
    13 |   r7 = take @user_id
    14 |   r8 = take $order
    15 |   r9 = call #0(r7) [r8 -> r10]
    16 |   assign $order = r10
    17 |   assign profile = r9
    18 |   r11 = take @user_id
    19 |   r12 = take $order
    20 |   r13 = call #1(r11) [r12 -> r14]
    21 |   assign $order = r14
    22 |   assign history = r13
    23 |   r15 = take profile
    24 |   r16 = take history
    25 |   r17 = take @weight
    26 |   r18 = call #2(r15, r16, r17)
    27 |   assign score = r18
    28 |   r19 = take profile
    29 |   r20 = take score
    30 |   r21 = call #3(r19, r20)
    31 |   assign label = r21
    32 |   r22 = take score
    33 |   r23 = take @threshold
    34 |   r24 = r22 > r23
    35 |   r25 = test r24 == true
    36 |   jump_if r25 then L0 else L1
    37 | L0:
    38 |   r26 = take @user_id
    39 |   r27 = take score
    40 |   r28 = take $order
    41 |   r29 = call #4(r26, r27) [r28 -> r30]
    42 |   assign $order = r30
    43 |   r31 = take @alert_count
    45 |   r32 = r31 + 1 (r33)
    46 |   assign @alert_count = r32
    47 |   jump L1
    48 | L1:
    49 |   r34 = take label
    50 |   assign @result_label = r34
    51 |   r35 = take score
    52 |   assign @result_score = r35
    53 |   r36 = take score
    54 |   r37 = take @result_label
    55 |   commit @result_label = r37
    56 |   r38 = take @weight
    57 |   commit @weight = r38
    58 |   r39 = take @alert_count
    59 |   commit @alert_count = r39
    60 |   r40 = take @result_score
    61 |   commit @result_score = r40
    62 |   r41 = take @threshold
    63 |   commit @threshold = r41
    64 |   r42 = take @user_id
    65 |   commit @user_id = r42
    66 |   r43 = take $order
    67 |   return r36 [r43]

