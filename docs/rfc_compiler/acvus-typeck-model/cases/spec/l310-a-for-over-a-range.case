//@ spec: l.310, l.320
// for i in 0..n {}   // n: u64
// lo..hi has a candidate (T, T) -> T for each integer T (l.320), written here
// at three integers; n decides u64, and i is its result (l.310).
extern fn range(u8, u8) -> u8;
extern fn range(u64, u64) -> u64;
extern fn range(i32, i32) -> i32;
let 0: lit 0;
let N: u64;
let I;
I = range(0, N) @ `0..n`;

must pass;
assert `0..n` == range#1;
assert I: u64;
