//@ spec: l.341, l.186, l.215, l.278, l.282
// let x: Vec<u8> = { Vec::new() };
// new's T is left in the lambda's C, and the call's instance copies it
// (l.215). The call's result passes into the Vec<u8> the text writes, a
// boundary whose split records a boundary toward u8 (l.278), and the copy of
// T, which nothing enters, is filled with u8 (l.282).
extern type Vec<T>;
extern fn new<T>() -> Vec<T>;
group λ in run {
    let `λ result`;
    let `new()`;
    fn λ() -> `λ result`;
    `λ result` = `new()`;
}
let E: u8;
let X: Vec<E>;
let `{..}`: lambda λ;
let `{..}()`;
`{..}()` = (`{..}`)() @ call;
X = `{..}()`;
group λ {
    `new()` = new() @ new;
}

must pass;
assert X: Vec<u8>;
