=== main ===
     0 |   r0 = fetch @acc
     1 |   assign @acc = r0
     2 |   r1 = fetch @items
     3 |   assign @items = r1
     4 |   r2 = take @items
     5 |   r3 = call #0(r2)
     6 |   assign it = r3
     7 |   jump L0
     8 | L0:
     9 |   r4 = ref &mut it
    10 |   r5 = call #1(r4)
    11 |   assign $source = r5
    12 |   r6 = ref &$source
    13 |   r7 = test r6 is Some
    14 |   jump_if r7 then L1 else L2
    15 | L1:
    16 |   r8 = take $source.payload
    17 |   assign x = r8
    18 |   r9 = take @acc
    19 |   r10 = take x
    20 |   r11 = r9 + r10
    21 |   assign @acc = r11
    22 |   jump L0
    23 | L2:
    24 |   r12 = take @acc
    25 |   r13 = take @acc
    26 |   commit @acc = r13
    27 |   r14 = take @items
    28 |   commit @items = r14
    29 |   return r12

